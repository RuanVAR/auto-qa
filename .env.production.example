# Single source of truth for production env. Copy this file to
# `.env.production` (which is gitignored) and fill in real values before
# running `pnpm run deploy:prod`.
#
# Every container reads from this file via `env_file:` in
# docker/prod/docker-compose.yml — no per-service env blocks.

# ─── Runtime mode ──────────────────────────────────────────────────────
NODE_ENV=production
# Makes deploys fail if backup/alerting controls below are incomplete. Keep true
# for a real production host; only set false for an intentionally non-prod dry run.
PRODUCTION_HARDENING_REQUIRED=true

# ─── Database ──────────────────────────────────────────────────────────
# Postgres credentials are used to start the DB container AND consumed by
# api/worker via DATABASE_URL. Keep them consistent.
POSTGRES_USER=qa_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=qa_platform
# Hostname `postgres` resolves to the postgres container inside the docker network
DATABASE_URL=postgresql://qa_user:CHANGE_ME_strong_password@postgres:5432/qa_platform

# ─── Redis / BullMQ ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379

# ─── JWT ───────────────────────────────────────────────────────────────
# MUST be ≥32 random chars in production. Rotate by issuing a new pair and
# revoking old refresh tokens.
JWT_SECRET=CHANGE_ME_at_least_32_random_chars
JWT_REFRESH_SECRET=CHANGE_ME_different_32_random_chars

# AES-256-GCM key encrypting environment/plugin credentials at rest. Generate
# with `openssl rand -base64 32`; do not replace an existing key without using
# SECRETS_KEK_PREVIOUS during the staged rotation described in the runbook.
SECRETS_KEK=CHANGE_ME_base64_32_byte_key
SECRETS_KEK_KEY_ID=v1
SECRETS_KEK_PREVIOUS=

# ─── AI provider ───────────────────────────────────────────────────────
# AI_PROVIDER: anthropic | openai | azure | ollama  (see docs/AI_LAYER.md)
AI_PROVIDER=anthropic
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_AZURE_INSTANCE=
AI_AZURE_DEPLOYMENT=
AI_AZURE_API_VERSION=
# Legacy/back-compat keys — still respected as fallback
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Embeddings + vector backend ───────────────────────────────────────
EMBEDDING_PROVIDER=openai
VECTOR_BACKEND=pgvector

# ─── Worker tuning ─────────────────────────────────────────────────────
WORKER_CONCURRENCY=3
# Browser concurrency. These two ADD UP — each PDF job launches its own Chromium
# in the same container as the run browsers, so the real ceiling on the host is
# WORKER_CONCURRENCY + PDF_WORKER_CONCURRENCY. On a 2 GB box, 3 + 1 is the
# tested limit.
# (MAX_CONCURRENT_RUNS / MAX_BROWSERS_PER_WORKER used to live here and were read
#  by no code at all — they implied a safety limit that did not exist.)
WORKER_CONCURRENCY=3
PDF_WORKER_CONCURRENCY=1
# Video is expensive and traces already carry screenshots/actions. Enable it
# only for projects that genuinely require recordings.
RECORD_VIDEO=false

# ── Observability ────────────────────────────────────────────────────────────
# Unset means no error reporting at all. Secrets are scrubbed before send.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Off-host database backups (scripts/backup-db.sh, nightly cron) ──────────
# Select s3 or azure. If omitted, exactly one configured target is selected.
BACKUP_PROVIDER=
# S3: credentials should live in the deploy user's IAM role or ~/.aws profile,
# not in this file (which is passed into application containers).
BACKUP_BUCKET=
# Azure Blob: use a DEDICATED private container, not the app-artifact one.
# Prefer BACKUP_AZURE_ACCOUNT with managed identity (`az login --identity`) on
# the host. Use a connection string only when managed identity is unavailable.
BACKUP_AZURE_CONTAINER=
BACKUP_AZURE_ACCOUNT=
BACKUP_AZURE_CONNECTION_STRING=
BACKUP_RETAIN_DAYS=30
BACKUP_MAX_AGE_HOURS=36
# AWS_ENDPOINT_URL=            # set for MinIO / R2 / Spaces

# ── Artifact retention (sweeps nightly at 03:00 UTC inside the API) ──────────
# Artifacts share a disk with Postgres; unbounded growth stops WAL writes.
ARTIFACT_RETENTION_ENABLED=true
RETENTION_VIDEO_DAYS=14
RETENTION_TRACE_DAYS=30
RETENTION_SCREENSHOT_DAYS=90
RETENTION_LOG_DAYS=30

# ── Disk alerting (scripts/disk-alert.sh, */15 cron) ─────────────────────────
DISK_WARN_PCT=75
DISK_PAGE_PCT=90
ALERT_WEBHOOK=
STEP_TIMEOUT_MS=30000
RUN_TIMEOUT_MS=300000

# ─── App URLs (used in emails, OAuth callbacks, CORS) ──────────────────
WEB_URL=https://qa.example.com
API_URL=https://api.qa.example.com

# ─── Host port for the web container ───────────────────────────────────
# Defaults to 80 (standard HTTP). Override to 8080 (or anything else) when
# running behind a reverse proxy that owns 80/443, or on a host where the
# Docker daemon doesn't have permission to bind privileged ports.
WEB_HOST_PORT=80

# ─── Storage ──────────────────────────────────────────────────────────
# Local-disk paths used when STORAGE_PROVIDER=local (the default + fallback).
ARTIFACT_STORAGE_PATH=/app/artifacts
# UPLOAD_STORAGE_PATH=/app/uploads

# Media storage backend for BOTH user uploads and run artifacts
# (screenshots / recordings). One switch; falls back to local on anything
# unset or misconfigured. See README "Media storage".
#   local | s3 | gcs | azure
STORAGE_PROVIDER=local

# --- AWS S3 (also S3-compatible: MinIO / Cloudflare R2 / DO Spaces / B2) ---
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For S3-compatible stores: set the endpoint URL + path-style addressing.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true

# --- Google Cloud Storage ---
GCS_BUCKET=
GCS_PROJECT_ID=
# Path to a service-account JSON key (mount it into the container as a volume).
GOOGLE_APPLICATION_CREDENTIALS=

# --- Azure Blob Storage ---
AZURE_CONTAINER=
# Either a full connection string…
AZURE_STORAGE_CONNECTION_STRING=
# …or an account name + key:
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=

# ─── SSO (optional) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
