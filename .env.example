# ─── Infrastructure ───────────────────────────────────────────────────────────
NODE_ENV=development

POSTGRES_USER=qa_user
POSTGRES_PASSWORD=qa_password
POSTGRES_DB=qa_platform

REDIS_PASSWORD=qa_redis_password

JWT_SECRET=change_me_in_production

WORKER_CONCURRENCY=3

# Datastore connections. In docker-compose these are built from the POSTGRES_*
# / REDIS_PASSWORD values above; set them explicitly for a non-docker run. The
# API fails fast at boot (assertRequiredEnv) if DATABASE_URL / REDIS_URL are
# missing.
# DATABASE_URL=postgresql://qa_user:qa_password@localhost:5432/qa_platform
# REDIS_URL=redis://localhost:6379

# ─── Platform identity ─────────────────────────────────────────────────────────
# Display name shown across the UI, emails, reports and certificates — one source
# of truth for both API and web. Defaults to "AdVantage".
APP_NAME=

# ─── Public URLs ───────────────────────────────────────────────────────────────
# Used for email links, OAuth callbacks and CORS. REQUIRED in production — the
# API fails fast at boot (assertProdUrls) if unset. Default to localhost in dev.
# WEB_URL=https://app.example.com
# API_URL=https://api.example.com

# ─── SSO / OAuth ──────────────────────────────────────────────────────────────
#
# Each provider is independently gated. Set *_SSO_ENABLED=true and fill in
# the corresponding credentials. The frontend hits GET /auth/config and
# only renders "Continue with X" buttons for providers that come back true.
#
# When a provider is disabled, the OAuth routes return 404 cleanly — no
# half-working surfaces.

# ── Google ────────────────────────────────────────────────────────────────────
# Defaults to ENABLED when GOOGLE_CLIENT_ID is set (backwards-compat with
# pre-flag deployments). Set GOOGLE_SSO_ENABLED=false to disable explicitly.
#
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET power BOTH Google SSO and the Google
# Drive plugin (Org → Plugins → Google Drive). When unset, the Drive plugin's
# connect flow returns a clear "not configured" message. In the GCP OAuth
# client, allow-list this exact Drive callback redirect URI (fixed — the org is
# carried in the OAuth state, not the URL):
#   <API_URL>/api/v1/gdrive/oauth/callback
# e.g. local dev: http://localhost:3001/api/v1/gdrive/oauth/callback
# and add the scope `https://www.googleapis.com/auth/drive.readonly`.
GOOGLE_SSO_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — derived from API_URL when not set
GOOGLE_CALLBACK_URL=

# ── Microsoft / Azure AD Entra ────────────────────────────────────────────────
# Defaults to DISABLED. Set MICROSOFT_SSO_ENABLED=true to turn on.
#
# MICROSOFT_TENANT_ID controls which accounts can sign in:
#   organizations    — any Microsoft work or school tenant (recommended for B2B)
#   common           — work, school, AND personal (outlook.com, hotmail.com)
#   consumers        — personal accounts only
#   <a GUID>         — single tenant (only users in that specific Entra org)
MICROSOFT_SSO_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
# Optional — derived from API_URL when not set
MICROSOFT_CALLBACK_URL=

# ─── AI Provider ──────────────────────────────────────────────────────────────
#
# Set AI_PROVIDER to one of:
#   anthropic         — Anthropic Claude (cloud)
#   openai            — OpenAI GPT (cloud)
#   azure             — Azure-hosted OpenAI (enterprise / sovereign cloud)
#   ollama            — Ollama running locally or on a private server
#   openai-compatible — Any OpenAI-compatible API: vLLM, LM Studio, llama.cpp …
#
# If AI_PROVIDER is not set, the platform falls back to whichever legacy key is
# present (ANTHROPIC_API_KEY → anthropic, OPENAI_API_KEY → openai).

AI_PROVIDER=anthropic

# Model name — provider-specific defaults are used when this is not set:
#   anthropic  → claude-sonnet-4-20250514
#   openai     → gpt-4o
#   azure      → gpt-4o  (or whatever your deployment is named)
#   ollama     → llama3
AI_MODEL=

# API key — not required for ollama or openai-compatible with no auth
AI_API_KEY=

# Max tokens to generate (default: 2048)
AI_MAX_TOKENS=2048

# ── Anthropic (AI_PROVIDER=anthropic) ────────────────────────────────────────
# Legacy key — still works if you don't set AI_PROVIDER / AI_API_KEY
ANTHROPIC_API_KEY=

# ── OpenAI (AI_PROVIDER=openai) ──────────────────────────────────────────────
# Legacy key — still works if you don't set AI_PROVIDER / AI_API_KEY
OPENAI_API_KEY=

# ── Azure OpenAI (AI_PROVIDER=azure) ─────────────────────────────────────────
# Your Azure OpenAI resource name (e.g. "my-company" → my-company.openai.azure.com)
AI_AZURE_INSTANCE=
# Deployment name in your Azure resource (defaults to AI_MODEL)
AI_AZURE_DEPLOYMENT=
# API version (default: 2024-05-01-preview)
AI_AZURE_API_VERSION=

# ── Ollama / OpenAI-compatible (AI_PROVIDER=ollama or openai-compatible) ──────
# Base URL of the model server
#   ollama            default: http://localhost:11434
#   openai-compatible required: e.g. http://localhost:8000/v1
AI_BASE_URL=

# ─── Plugin Registry (5.3) ────────────────────────────────────────────────────
#
# 32-byte base64 key for AES-256-GCM secret encryption. Encrypts plugin
# credentials (e.g. ClickUp PAT), AND — Phase 5c — per-environment login
# credentials + environment variables/headers at rest. The WORKER must have the
# SAME SECRETS_KEK as the API (it decrypts credentials at run start).
# Generate with:  openssl rand -base64 32
SECRETS_KEK=
# Previous KEK during rotation. Decrypt-only; new writes use SECRETS_KEK.
SECRETS_KEK_PREVIOUS=

# Full-run video recording (Phase 5a). Worker records a .webm per automated run
# (reviewable on the run detail page). Set false to disable globally.
RECORD_VIDEO=true

# Health-check cron for installed plugins (every 15 min by default)
PLUGIN_HEALTH_CHECK_CRON=*/15 * * * *

# How long signed URLs to artifact storage stay valid when injected into
# external ticket descriptions (e.g. ClickUp attachments that exceeded the
# upload size threshold).
ARTIFACT_SIGNED_URL_TTL_DAYS=30

# Webhook event payload retention. "digest" stores SHA-256 only; "full"
# stores the raw payload (off by default — payloads can leak PII / secrets).
WEBHOOK_PAYLOAD_RETENTION=digest

# ─── Media storage ─────────────────────────────────────────────────────
# Backend for user uploads + run artifacts (screenshots / recordings).
# local (default + fallback) | s3 | gcs | azure. See README "Media storage".
STORAGE_PROVIDER=local
# Local-disk roots (used when STORAGE_PROVIDER=local):
# UPLOAD_STORAGE_PATH=./uploads
# ARTIFACT_STORAGE_PATH=./.artifacts
#
# S3 (or S3-compatible — MinIO / R2 / Spaces / B2 via S3_ENDPOINT):
# S3_BUCKET=          S3_REGION=
# AWS_ACCESS_KEY_ID=  AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=        S3_FORCE_PATH_STYLE=true
#
# Google Cloud Storage:
# GCS_BUCKET=  GCS_PROJECT_ID=  GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
#
# Azure Blob Storage:
# AZURE_CONTAINER=  AZURE_STORAGE_CONNECTION_STRING=
# (or)  AZURE_STORAGE_ACCOUNT=  AZURE_STORAGE_KEY=
