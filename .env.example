# ─── Infrastructure ───────────────────────────────────────────────────────────
NODE_ENV=development

POSTGRES_USER=qa_user
POSTGRES_PASSWORD=qa_password
POSTGRES_DB=qa_platform

REDIS_PASSWORD=qa_redis_password

JWT_SECRET=change_me_in_production

WORKER_CONCURRENCY=3

# ─── AI Provider ──────────────────────────────────────────────────────────────
#
# Set AI_PROVIDER to one of:
#   anthropic         — Anthropic Claude (cloud)
#   openai            — OpenAI GPT (cloud)
#   azure             — Azure-hosted OpenAI (enterprise / sovereign cloud)
#   ollama            — Ollama running locally or on a private server
#   openai-compatible — Any OpenAI-compatible API: vLLM, LM Studio, llama.cpp …
#
# If AI_PROVIDER is not set, the platform falls back to whichever legacy key is
# present (ANTHROPIC_API_KEY → anthropic, OPENAI_API_KEY → openai).

AI_PROVIDER=anthropic

# Model name — provider-specific defaults are used when this is not set:
#   anthropic  → claude-sonnet-4-20250514
#   openai     → gpt-4o
#   azure      → gpt-4o  (or whatever your deployment is named)
#   ollama     → llama3
AI_MODEL=

# API key — not required for ollama or openai-compatible with no auth
AI_API_KEY=

# Max tokens to generate (default: 2048)
AI_MAX_TOKENS=2048

# ── Anthropic (AI_PROVIDER=anthropic) ────────────────────────────────────────
# Legacy key — still works if you don't set AI_PROVIDER / AI_API_KEY
ANTHROPIC_API_KEY=

# ── OpenAI (AI_PROVIDER=openai) ──────────────────────────────────────────────
# Legacy key — still works if you don't set AI_PROVIDER / AI_API_KEY
OPENAI_API_KEY=

# ── Azure OpenAI (AI_PROVIDER=azure) ─────────────────────────────────────────
# Your Azure OpenAI resource name (e.g. "my-company" → my-company.openai.azure.com)
AI_AZURE_INSTANCE=
# Deployment name in your Azure resource (defaults to AI_MODEL)
AI_AZURE_DEPLOYMENT=
# API version (default: 2024-05-01-preview)
AI_AZURE_API_VERSION=

# ── Ollama / OpenAI-compatible (AI_PROVIDER=ollama or openai-compatible) ──────
# Base URL of the model server
#   ollama            default: http://localhost:11434
#   openai-compatible required: e.g. http://localhost:8000/v1
AI_BASE_URL=

# ─── Plugin Registry (5.3) ────────────────────────────────────────────────────
#
# 32-byte base64 key for AES-256-GCM secret encryption of plugin credentials
# (e.g. ClickUp PAT). Generate with:  openssl rand -base64 32
SECRETS_KEK=
# Previous KEK during rotation. Decrypt-only; new writes use SECRETS_KEK.
SECRETS_KEK_PREVIOUS=

# Health-check cron for installed plugins (every 15 min by default)
PLUGIN_HEALTH_CHECK_CRON=*/15 * * * *

# How long signed URLs to artifact storage stay valid when injected into
# external ticket descriptions (e.g. ClickUp attachments that exceeded the
# upload size threshold).
ARTIFACT_SIGNED_URL_TTL_DAYS=30

# Webhook event payload retention. "digest" stores SHA-256 only; "full"
# stores the raw payload (off by default — payloads can leak PII / secrets).
WEBHOOK_PAYLOAD_RETENTION=digest
