generator client {
  provider      = "prisma-client-js"
  // Multiple engine binaries so the same generated client works on the host
  // (macOS / native dev) AND inside the Docker dev image (Debian + OpenSSL 3).
  // Without `debian-openssl-3.0.x` the API container fails to boot when the
  // bind-mounted node_modules carries only a darwin engine.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

// ─── Issue Tracking ──────────────────────────────────────────────────────────
enum IssueType {
  BUG
  SNAG
  QUERY
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  READY_FOR_QA
  RESOLVED
  WONT_FIX
  CLOSED
}

// Legacy single-tenant role — kept for backwards compatibility during Phase 6 migration
enum UserRole {
  ADMIN
  ENGINEER
  VIEWER
}

// Multi-tenant platform role — replaces UserRole once Phase 6 is complete
enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

// Account lifecycle state — controls whether the user can log in
enum AccountStatus {
  PENDING_ACTIVATION // registered; activation email sent, not yet verified
  PENDING_APPROVAL // email verified; awaiting PLATFORM_ADMIN approval
  ACTIVE // fully approved, can log in
  SUSPENDED // temporarily blocked (org SSO enforcement, billing, etc.)
  DEACTIVATED // permanently disabled; data retained, login blocked
}

// Org-level role
enum OrgRole {
  ORG_ADMIN // full org management: invite, remove, manage projects
  ORG_MEMBER // basic org member; access via ProjectMember
}

// Project-level role
enum ProjectRole {
  OWNER // created the project; all permissions
  TECH_LEAD // manage tests, environments, view all
  DEVELOPER // run tests, view results, access stats
  QA_ENGINEER // full test access, authoring, run, stats
  MANAGER // manage the project + run the sign-off flow
  CLIENT // stakeholder — reviews evidence and signs off; no authoring
}

// Invite status
enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum EnvironmentType {
  LOCAL
  STAGING
  PRODUCTION
  INTERNAL
  CUSTOM
}

enum RunStatus {
  PENDING
  QUEUED
  RUNNING
  PASSED
  FAILED
  CANCELLED
  TIMED_OUT
  ERROR
  // The tester ended their manual session before evaluating this test — a
  // normal end, not an abort, and not a verdict. Excluded from pass-rate and
  // never overrides a prior PASSED/FAILED for the test.
  NOT_TESTED
  // The tester explicitly hit "Skip" on a test. A real verdict (the test was
  // exercised and intentionally not run), distinct from CANCELLED (a stopped
  // run). Counts toward coverage/progress; excluded from pass-rate.
  SKIPPED
}

/// Why a test failed — captured when QA marks a test FAILED. Drives the
/// failure-type analytics (doughnut of why tests fail).
enum TestFailureCategory {
  FUNCTIONALITY // behaves wrong / doesn't work as specified
  DESIGN_MISMATCH // UI doesn't match the design
  MISSING_ELEMENT // an expected component / element is absent
  CONTENT_ERROR // wrong text, copy, labels, translations
  DATA_VALIDATION // wrong data shown, or validation broken
  PERFORMANCE // slow, laggy, timed out
  INTEGRATION // external service / API failure
  CRASH_ERROR // the app crashed or threw an error
  REGRESSION // used to work — newly broken
  ENVIRONMENT // environment / setup issue, not a product defect
  TEST_ISSUE // the test itself is wrong (false fail)
  OTHER // doesn't fit a category — see the note
  // Appended (not before OTHER) so the physical enum order matches this file
  // and Prisma sees no drift. UI ordering is controlled separately.
  DOCUMENTATION_MISMATCH // docs / test case don't match the actual (correct) behaviour
}

// First-pass automated triage (docs/plan/05-PHASE-3-INTELLIGENCE.md §3.4) —
// deliberately coarser and more conservative than TestFailureCategory above,
// which stays human-assigned. A step either gets a heuristic bucket or stays
// null; nothing is guessed into a bucket, because a wrong confident label is
// worse than no label.
enum TriageBucket {
  PRODUCT
  AUTOMATION
  ENVIRONMENT
}

enum StepStatus {
  PENDING
  RUNNING
  PASSED
  // Passed, but only after a selector fallback was used (selector drift
  // detection — docs/plan/04-PHASE-2-HEALING.md §2.2). Counts as PASSED for
  // gating, pass rate and sign-off — the test did verify the behaviour — but
  // is never indistinguishable from a clean pass anywhere in the UI. A heal
  // that fires must never silently report as a clean pass; that is precisely
  // the failure mode this feature exists to avoid.
  PASSED_HEALED
  FAILED
  SKIPPED
  ABORTED
  ERROR
}

enum StepType {
  // UI (Playwright) step types
  NAVIGATE
  CLICK
  DBLCLICK
  FILL
  TYPE
  CLEAR
  SELECT
  CHECK
  UNCHECK
  ASSERT_TEXT
  ASSERT_VISIBLE
  ASSERT_VALUE
  ASSERT_URL
  ASSERT_ELEMENT
  WAIT
  WAIT_FOR_SELECTOR
  WAIT_FOR_NAVIGATION
  WAIT_MS
  SCREENSHOT
  FILE_UPLOAD
  KEYBOARD
  PRESS_KEY
  SCROLL
  HOVER
  EXECUTE_SCRIPT
  STORE
  EMIT_METRIC
  CUSTOM
  // API step types
  REQUEST
  ASSERT_STATUS
  ASSERT_BODY
  ASSERT_HEADER
  EXTRACT
  DELAY
  // Shell step types
  COMMAND
  ASSERT_EXIT
  ASSERT_OUTPUT
  ASSERT_CONTAINS
  // API_REQUEST kept for backwards compat
  API_REQUEST
}

enum TestCaseType {
  UI
  API
  SHELL
  SCRIPT // full Playwright JS (config.script), run in the worker's vm sandbox
}

enum ArtifactType {
  SCREENSHOT
  TRACE
  VIDEO
  LOG
  REPORT
  HAR
}

enum AISummaryType {
  RUN_SUMMARY
  FAILURE_EXPLANATION
  TEST_GENERATION
  RECOMMENDATION
  EXPLORATORY_REPORT
  AC_EXTRACTION
}

// AI provider — populated when an org configures BYOK. Mirrors the
// AiProviderType string union in provider.factory.ts (uppercased).
enum AiProvider {
  ANTHROPIC
  OPENAI
  GEMINI
  AZURE
  OLLAMA
  OPENAI_COMPATIBLE
}

enum FeatureRunStatus {
  IDLE
  RUNNING
  PAUSED
  COMPLETE
  CANCELLED
}

enum RunMode {
  AUTOMATED // Playwright executes steps; live screencast shown
  MANUAL // Engineer executes steps; app rendered in iframe or new tab
}

// Records who actually executed a single step, independent of the run's
// initial runMode. Lets a run be "mostly automated, two steps manual"
// without losing fidelity in reports.
enum ExecutedBy {
  AUTOMATED
  MANUAL
}

// 6-F Access Requests
enum AccessRequestType {
  ORG
  PROJECT
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// 6-G SSO provider identifier
enum SsoProvider {
  GOOGLE
  MICROSOFT
}

// ─── Core models ──────────────────────────────────────────────────────────────

model Organisation {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  logoUrl           String?
  primaryColor      String? // org brand accent, hex #rrggbb — drives per-org theming
  website           String?
  description       String?
  isActive          Boolean            @default(true)
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  ownerId           String // the user who registered the org
  // 6-G SSO settings
  ssoDomain         String? // e.g. "acme-corp.com" — enables domain auto-join
  ssoEnforced       Boolean            @default(false) // if true, password login disabled for members
  allowedSsoDomains String[]           @default([]) // additional domains that can auto-join
  // Domain auto-join: when true, a user registering with an email whose domain
  // is in {ssoDomain} ∪ allowedSsoDomains is offered "request to join this org"
  // → creates a PENDING org AccessRequest (admin approves + sets the role).
  // Explicit toggle so listing a domain (e.g. for SSO) doesn't silently open
  // the door.
  autoJoinEnabled   Boolean            @default(false)
  // ── Inbound project transfers ───────────────────────────────────────────
  // Opaque, rotatable code that another org's admin types to target THIS org
  // as a transfer destination. Deliberately not the slug: the slug is public
  // and enumerable (it lives in URLs), so using it would let anyone spray
  // transfer requests at any org, and it can't be rotated without breaking
  // links. Treat this as a shared secret — rotate to revoke.
  transferCode      String?            @unique
  // Kill-switch: when false the org refuses inbound transfer requests outright.
  acceptsTransfers  Boolean            @default(true)
  members           OrgMember[]
  invites           OrgInvite[]
  projects          Project[]
  transfersOut      ProjectTransferRequest[] @relation("TransfersFromOrg")
  transfersIn       ProjectTransferRequest[] @relation("TransfersToOrg")
  auditLogs         AuditLog[]
  accessRequests    AccessRequest[]
  // 5.3 Plugin registry
  pluginInstalls    OrgPluginInstall[]
  ticketLinks       TicketLink[]
  docLinks          DocLink[]
  docs              Doc[]
  webhookEvents     WebhookEvent[]
  workSessions      QaWorkSession[]
  aiCredential      OrgAiCredential?
  aiSummaries       AISummary[]
  clickupUserLinks  ClickUpUserLink[]
  gitCredentials    OrgGitCredential[]

  @@map("organisations")
}

model OrgMember {
  id        String       @id @default(uuid())
  role      OrgRole      @default(ORG_MEMBER)
  joinedAt  DateTime     @default(now())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("org_members")
}

model OrgInvite {
  id          String       @id @default(uuid())
  email       String
  role        OrgRole      @default(ORG_MEMBER)
  token       String       @unique @default(uuid())
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orgId       String
  org         Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User         @relation("SentInvites", fields: [invitedById], references: [id])

  // Pre-scoped project + environment assignments. Applied automatically when
  // the invitee accepts. Shape:
  //   [{ projectId, role: ProjectRole, allowedEnvironmentIds: string[] }, ...]
  // Empty/null = org-only invite (legacy behaviour preserved).
  projectAssignments Json?

  @@map("org_invites")
}

model ProjectMember {
  id        String      @id @default(uuid())
  role      ProjectRole @default(QA_ENGINEER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Which environments this member can access within the project.
  // Empty array = access to ALL environments (default for OWNER/TECH_LEAD/ORG_ADMIN).
  // Non-empty = restricted to only the listed environment IDs.
  // Used to restrict QA engineers to the QA env and UAT users to the staging env.
  allowedEnvironmentIds String[] @default([])

  @@unique([projectId, userId])
  @@map("project_members")
}

model User {
  id                         String                   @id @default(uuid())
  email                      String                   @unique
  name                       String
  avatarUrl                  String?
  passwordHash               String?
  role                       UserRole                 @default(ENGINEER) // legacy — use platformRole in Phase 6+
  platformRole               PlatformRole             @default(USER)
  accountStatus              AccountStatus            @default(PENDING_ACTIVATION)
  activationToken            String?                  @unique // email verification token; null once verified
  activationSentAt           DateTime? // when activation email was last dispatched
  pendingEmail               String? // email change requested but not yet confirmed
  pendingEmailToken          String?                  @unique // verification token sent to pendingEmail
  pendingEmailRequestedAt    DateTime? // when the email change was initiated
  approvedById               String? // PLATFORM_ADMIN who approved this account
  approvedAt                 DateTime?
  approverNote               String?
  lastActiveOrgId            String? // persisted org switcher state
  notificationPrefs          Json                     @default("{}")
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  projects                   Project[]
  runs                       TestRun[]
  auditLogs                  AuditLog[]
  featureVersions            FeatureVersion[]
  featureRuns                FeatureRun[]
  orgMemberships             OrgMember[]
  sentInvites                OrgInvite[]              @relation("SentInvites")
  projectMembers             ProjectMember[]
  signoffs                   PhaseSignoff[]
  reportConfigs              ReportConfig[]
  generatedReports           GeneratedReport[]
  // 6-F Access Requests
  requestsMade               AccessRequest[]          @relation("RequestsMade")
  requestsReviewed           AccessRequest[]          @relation("RequestsReviewed")
  transfersRequested         ProjectTransferRequest[] @relation("TransfersRequested")
  transfersReviewed          ProjectTransferRequest[] @relation("TransfersReviewed")
  // 6-G SSO
  ssoAccounts                UserSsoAccount[]
  refreshTokens              UserRefreshToken[]
  apiTokens                  UserApiToken[]
  // 5.7 Testing Phases
  phaseAssignments           PhaseAssignment[]
  featurePhasePromotions     FeaturePhase[]           @relation("FeaturePhasePromotions")
  featureSignOffs            FeatureSignOff[]         @relation("FeatureSignOffs")
  // Sign-off system
  signoffApproverOf          SignoffApprover[]
  signoffApprovals           SignoffApproval[]
  moduleEnvSignoffs          ModuleEnvSignoff[]
  signoffEvents              SignoffEvent[]
  reportSchedulesCreated     PhaseReportSchedule[]
  runSchedulesCreated        RunSchedule[]
  pipelinesCreated           Pipeline[]
  pipelineRunsCreated        PipelineRun[]
  // 5.3 Plugin registry
  pluginInstallsCreated      OrgPluginInstall[]       @relation("PluginInstallCreator")
  clickupUserLinks           ClickUpUserLink[]        @relation("UserClickUpLinks")
  clickupTokens              UserClickUpToken[]       @relation("UserClickUpTokens")
  ticketSuggestionsApplied   TicketStatusSuggestion[] @relation("TicketSuggestionApplier")
  ticketSuggestionsDismissed TicketStatusSuggestion[] @relation("TicketSuggestionDismisser")
  docsAuthored               Doc[]                    @relation("DocAuthor")
  docsEdited                 Doc[]                    @relation("DocEditor")
  // Notifications
  notifications              Notification[]
  // Import history
  importLogs                 ImportLog[]              @relation("ImportedBy")
  // Issue tracking
  reportedIssues             Issue[]                  @relation("IssueReporter")
  assignedIssues             Issue[]                  @relation("IssueAssignee")
  resolvedIssues             Issue[]                  @relation("IssueResolver")
  issueStatusHistory         IssueStatusHistory[]
  issueComments              IssueComment[]
  // Uploads
  uploads                    Upload[]                 @relation("UserUploads")
  // Work sessions
  workSessions               QaWorkSession[]
  // Issue views
  issueViews                 IssueView[]
  // Personal project notes
  projectNotes               UserProjectNote[]
  // AI credentials this user provisioned (org-level BYOK)
  aiCredentialsCreated       OrgAiCredential[]
  // Last-selected env per project (env switcher persistence)
  envPreferences             UserEnvPreference[]
  // Named manual Test Runs this user started
  testRunSessions            TestRunSession[]
  // Test notes this user last edited (the shared per-test note)
  editedTestNotes            TestNote[]               @relation("TestNoteEditor")
  // Features this user is the assigned developer on
  featuresAsDeveloper        Feature[]                @relation("FeatureDeveloper")
  // Selector-drift heals this user approved into the stored step definition
  selectorHealsPromoted      SelectorHeal[]

  @@map("users")
}

model PlatformConfig {
  id                          String   @id @default(uuid())
  key                         String   @unique
  value                       String
  isSecret                    Boolean  @default(false)
  category                    String?
  requireRegistrationApproval Boolean  @default(false) // when true, new self-registrations enter PENDING_APPROVAL after email verification
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("platform_config")
}

model Project {
  id                 String                 @id @default(uuid())
  name               String
  // Slug is unique per organisation, not platform-wide (NULL-org projects are unconstrained).
  slug               String
  description        String?
  isActive           Boolean                @default(true)
  bugTrackingEnabled Boolean                @default(true)
  // Selector drift detection confidence floor (docs/plan/04-PHASE-2-HEALING.md
  // §2.4 rule 2) — below this, fail the step and flag it rather than healing.
  // Default 0.65 means the `low` confidence bucket never auto-heals.
  healSensitivity    Float                  @default(0.65)
  // Flake scoring monitors (docs/plan/05-PHASE-3-INTELLIGENCE.md §3.5) —
  // three independent signals rather than one opaque score, because a single
  // number hides *why* a test was flagged. Shape:
  // { passOnRetry: boolean, transitionCount: boolean, failureRate: boolean,
  //   failureRateThreshold: number (0-1), failureRateWindowDays: number }
  // Defaults match the doc: the two high-precision monitors on, the noisier
  // failure-rate monitor off until a project opts in.
  flakeConfig        Json                   @default("{\"passOnRetry\":true,\"transitionCount\":true,\"failureRate\":false,\"failureRateThreshold\":0.3,\"failureRateWindowDays\":14}")
  deletedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  ownerId            String
  owner              User                   @relation(fields: [ownerId], references: [id])
  orgId              String?
  org                Organisation?          @relation(fields: [orgId], references: [id])
  environments       Environment[]
  testDefinitions    TestDefinition[]
  runs               TestRun[]
  modules            Module[]
  members            ProjectMember[]
  accessRequests     AccessRequest[]
  phases             ProjectPhase[]
  reportSchedules    PhaseReportSchedule[]
  runSchedules       RunSchedule[]
  pipelines          Pipeline[]
  reportConfigs      ReportConfig[]
  generatedReports   GeneratedReport[]
  // 5.3 Plugin registry
  pluginBindings     ProjectPluginBinding[]
  ticketLinks        TicketLink[]
  docLinks           DocLink[]
  docs               Doc[]
  importLogs         ImportLog[]
  issues             Issue[]
  userNotes          UserProjectNote[]
  repos              ProjectRepo[]
  // Sign-off system
  signoffApprovers   SignoffApprover[]
  signoffEvents      SignoffEvent[]
  envPreferences     UserEnvPreference[]
  testRunSessions    TestRunSession[]
  transferRequests   ProjectTransferRequest[]

  // Outbound webhook — a signed feature_run.completed event is POSTed here
  // when a feature run finishes. HMAC-SHA256 secret encrypted at rest with
  // the KEK (same scheme as Environment variables).
  webhookUrl              String?
  webhookSecretCiphertext Bytes?
  webhookSecretKeyId      String?

  @@unique([orgId, slug])
  @@map("projects")
}

model Module {
  id               String                @id @default(uuid())
  name             String
  description      String?
  order            Int                   @default(0)
  tags             String[]              @default([])
  isActive         Boolean               @default(true)
  deletedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  projectId        String
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features         Feature[]
  snapshots        ModuleVersion[]
  issues           Issue[]
  generatedReports GeneratedReport[]
  // 5.3 Plugin registry
  pluginBindings   ModulePluginBinding[]
  docLinks         DocLink[]
  docs             Doc[]
  TicketLink       TicketLink[]
  envSignoffs      ModuleEnvSignoff[]

  @@map("modules")
}

// Snapshot saved before each module edit — max 5 kept per module
model ModuleVersion {
  id            String   @id @default(uuid())
  versionNumber Int // 1-based, latest = highest
  label         String // e.g. "Before rename", "Before import"
  snapshot      Json // copy of: name, description, tags, order
  savedAt       DateTime @default(now())
  moduleId      String
  module        Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, versionNumber])
  @@map("module_versions")
}

model Feature {
  id               String                 @id @default(uuid())
  name             String
  description      String?
  order            Int                    @default(0)
  tags             String[]               @default([])
  isActive         Boolean                @default(true)
  isDraft          Boolean                @default(true)
  activeVersionId  String?
  // Fan-out budget for automated feature runs (docs/plan/06-PHASE-4-SCALE.md
  // §4.1). Null = DEFAULT_FEATURE_CONCURRENCY. Set to 1 for a feature whose
  // tests share state (a test account, server-side session) and must not
  // run concurrently — this doubles as the "serial" flag the plan proposed
  // as a separate boolean; a dedicated flag would just be sugar over the
  // same mechanism. Snapshotted onto FeatureRun.concurrency at run creation
  // so an edit here never changes an in-flight run's behavior.
  concurrency      Int?
  // De-parallelising retry ladder (docs/plan/06-PHASE-4-SCALE.md §4.2):
  // attempt 1 all-parallel, attempt 2 failures re-run in batches of 5,
  // attempt 3 failures re-run serially. Default on — this is a diagnostic
  // signal (which attempt a test passed at tells you whether it's a real
  // failure or contention-flake), not a masking mechanism; can be disabled.
  retryLadderEnabled Boolean @default(true)
  // Fail-fast / auto-cancellation (docs/plan/06-PHASE-4-SCALE.md §4.5). Off
  // by default. Only actionable when retryLadderEnabled is off for this run
  // — see the note on FeatureRun.failFast for why: the ladder retries the
  // WHOLE feature run's failures together in lockstep waves, so a failure
  // isn't "final" (safe to fail-fast on) until every test has already had
  // its first attempt, by which point there is nothing left to skip.
  failFast         Boolean @default(false)
  // Optional assigned developer (any project member). Drives per-developer
  // analytics and ClickUp auto-assign. SetNull so removing a user doesn't
  // delete the feature.
  developerId      String?
  deletedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  moduleId         String
  module           Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  developer        User?                  @relation("FeatureDeveloper", fields: [developerId], references: [id], onDelete: SetNull)
  testDefinitions  TestDefinition[]
  versions         FeatureVersion[]
  featureRuns      FeatureRun[]
  runSchedules     RunSchedule[]
  pipelineStages   PipelineStage[]
  featurePhases    FeaturePhase[]
  signOff          FeatureSignOff?
  // 5.3 Plugin registry
  pluginBindings   FeaturePluginBinding[]
  ticketLinks      TicketLink[]
  docLinks         DocLink[]
  docs             Doc[]
  issues           Issue[]
  generatedReports GeneratedReport[]
  envSignoffs      FeatureEnvSignoff[]
  // Named manual Test Runs kicked off from this feature
  startedTestRunSessions TestRunSession[] @relation("RunSessionStartFeature")

  @@index([developerId])
  @@map("features")
}

model FeatureVersion {
  id            String       @id @default(uuid())
  versionNumber Int
  label         String // e.g. "v1.0"
  name          String // user-provided name
  description   String? // changelog
  snapshot      Json // immutable copy of all test definitions + steps
  snapshotHash  String // SHA-256 for change detection
  isActive      Boolean      @default(false)
  publishedAt   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  featureId     String
  feature       Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])
  testRuns      TestRun[]
  featureRuns   FeatureRun[]

  @@unique([featureId, versionNumber])
  @@map("feature_versions")
}

model Environment {
  id            String          @id @default(uuid())
  name          String
  type          EnvironmentType @default(STAGING)
  baseUrl       String
  embedAllowed  Boolean         @default(true) // false = skip iframe attempt, show "Open in new tab" directly
  supportsAutomation Boolean    @default(false) // true = a legal target for automated (Playwright) runs. The sole gate for automation availability.
  description   String?
  // headers/variables: legacy plaintext JSON. New writes encrypt into the
  // *Ciphertext columns below (dual-read: prefer ciphertext, fall back to these
  // until a row is next saved). Phase 5c — encrypt env config at rest.
  headers       Json?
  variables     Json?
  variablesCiphertext Bytes?
  variablesKeyId      String?
  headersCiphertext   Bytes?
  headersKeyId        String?
  isActive      Boolean         @default(true)
  order         Int             @default(0) // display order in pickers and dropdowns
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs          TestRun[]
  featureRuns   FeatureRun[]
  runSchedules  RunSchedule[]
  pipelineStages PipelineStage[]
  projectPhases ProjectPhase[]
  signoffs      PhaseSignoff[]
  // Sign-off system
  featureSignoffs  FeatureEnvSignoff[]
  moduleSignoffs   ModuleEnvSignoff[]
  signoffApprovers SignoffApprover[]
  envPreferences   UserEnvPreference[]
  testRunSessions  TestRunSession[]
  credentials      EnvironmentCredential[]

  @@index([projectId, order])
  @@map("environments")
}

/// A named, encrypted login credential scoped to an environment (Phase 5c).
/// Multiple per env (e.g. "login", "admin", "readonly") for role-based testing.
/// secretsCiphertext is an AES-256-GCM envelope of a JSON {KEY: value} map
/// (e.g. {EMAIL, PASSWORD}); at run start the worker decrypts it and injects
/// the fields as {{NAME_KEY}} variables. Managed by project QA leads.
model EnvironmentCredential {
  id                String      @id @default(uuid())
  environmentId     String
  environment       Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  name              String
  secretsCiphertext Bytes
  secretsKeyId      String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  createdById       String?

  @@unique([environmentId, name])
  @@map("environment_credentials")
}

/// A user's last-selected environment per project — so the env switcher
/// restores their working env on any device / fresh login (not just same-browser
/// localStorage). One row per (user, project); the env cascade-deletes the row
/// so a removed env falls back to the project default.
model UserEnvPreference {
  id            String      @id @default(uuid())
  userId        String
  projectId     String
  environmentId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, projectId])
  @@index([environmentId])
  @@map("user_env_preferences")
}

model TestDefinition {
  id                   String                  @id @default(uuid())
  name                 String
  description          String?
  type                 TestCaseType            @default(UI)
  tags                 String[]
  steps                Json
  config               Json?
  // Enqueue/display order within a feature (docs/plan/06-PHASE-4-SCALE.md
  // §4.1/§4.4 — LPT bin-packing sorts within this before duration). Default
  // 0 for every existing test preserves today's createdAt-only ordering.
  order                Int                     @default(0)
  isActive             Boolean                 @default(true)
  isAiDraft            Boolean                 @default(false)
  // Audit trail for AI-generated tests — captures the prompt version,
  // source snippet, and extracted AC. Null for human-authored tests.
  aiGenerationMetadata Json?
  version              Int                     @default(1)
  deletedAt            DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  projectId            String
  project              Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  featureId            String?
  feature              Feature?                @relation(fields: [featureId], references: [id])
  runs                 TestRun[]
  snapshots            TestDefinitionVersion[]
  issues               Issue[]
  docLinks             DocLink[]
  docs                 Doc[]
  acSource             TestAcSourceLink?
  note                 TestNote?
  selectorHeals        SelectorHeal[]

  @@map("test_definitions")
}

// Snapshot saved before each edit — max 5 kept per test case
model TestDefinitionVersion {
  id               String         @id @default(uuid())
  versionNumber    Int // 1-based, latest = highest
  label            String // e.g. "Before edit", "Before import"
  snapshot         Json // full copy: name, description, type, tags, steps, config
  savedAt          DateTime       @default(now())
  testDefinitionId String
  testDefinition   TestDefinition @relation(fields: [testDefinitionId], references: [id], onDelete: Cascade)

  @@unique([testDefinitionId, versionNumber])
  @@map("test_definition_versions")
}

model TestRun {
  id               String          @id @default(uuid())
  status           RunStatus       @default(PENDING)
  runMode          RunMode         @default(AUTOMATED)
  trigger          String          @default("manual")
  // Ephemeral debug run — created by the test editor's "Preview" button so
  // QA can watch a test execute live (and see what breaks) without the run
  // counting toward history, pass rate, donut counts, or per-test badges.
  // Filtered out of every history/stats query; LiveRunModal still works
  // because it watches by id, not by listing.
  isPreview        Boolean         @default(false)
  // Denormalized from the parent FeatureRun so pipeline drill-downs need no
  // join. Plain column, no FK: the FeatureRun back-link is authoritative.
  pipelineRunId    String?
  // Result isolation, decided AT CREATION: true for stage runs of a pipeline
  // with updatesFeatureStatus=false. CANONICAL_RUN_FILTER excludes these from
  // latest-status/stats/flaky/analytics. Stamped (not derived per query) so
  // an opted-in pipeline's runs count and a later toggle can't rewrite history.
  excludedFromCanonical Boolean @default(false)
  startedAt        DateTime?
  completedAt      DateTime?
  duration         Int?
  errorMessage     String?
  metadata         Json?
  // Structured failure reason — set when QA marks the run FAILED. Stays as
  // history if the test is later re-passed (a new run supersedes this one).
  failureCategory  TestFailureCategory?
  failureNote      String?
  // Evidence captured at fail time (screenshots / a screen recording), so the
  // "why" is reviewable on the test later — survives logout. Mirrors Issue.
  failureScreenshotUrls String[]   @default([])
  failureRecordingUrl   String?
  // Count of steps in this run that passed only via a selector fallback
  // (docs/plan/04-PHASE-2-HEALING.md §2.2) — a green run that leaned on
  // healing must be visible at a glance, not indistinguishable from a clean one.
  healCount        Int             @default(0)
  // De-parallelising retry ladder (docs/plan/06-PHASE-4-SCALE.md §4.2). This
  // row is reset in place for a retry (status back to PENDING, old RunSteps
  // deleted) rather than creating a new TestRun — ladderAttempt tracks which
  // wave the CURRENT execution is; passedAtAttempt freezes the wave a PASSED
  // result actually landed on, which is itself a diagnosis (1 = fine, 2 =
  // contention under concurrency, 3 = hard contention/real race).
  ladderAttempt    Int             @default(1)
  passedAtAttempt  Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id])
  environmentId    String?
  environment      Environment?    @relation(fields: [environmentId], references: [id])
  testDefinitionId String
  testDefinition   TestDefinition  @relation(fields: [testDefinitionId], references: [id])
  triggeredById    String?
  triggeredBy      User?           @relation(fields: [triggeredById], references: [id])
  featureRunId     String?
  featureRun       FeatureRun?     @relation(fields: [featureRunId], references: [id])
  featureVersionId String?
  featureVersion   FeatureVersion? @relation(fields: [featureVersionId], references: [id])
  steps            RunStep[]
  artifacts        Artifact[]
  aiSummaries      AISummary[]
  selectorHeals    SelectorHeal[]
  workSessionId    String?
  workSession      QaWorkSession?  @relation(fields: [workSessionId], references: [id], onDelete: SetNull)
  // Named manual Test Run this result belongs to (null for automated / ad-hoc).
  testRunSessionId String?
  testRunSession   TestRunSession? @relation(fields: [testRunSessionId], references: [id], onDelete: SetNull)

  @@index([workSessionId])
  @@index([testRunSessionId, status]) // "results in a named run, by status"
  // Hot-query indexes
  @@index([featureRunId, status]) // "tests in a feature run, by status"
  @@index([status, createdAt]) // "recent runs by status" (run history filters)
  @@index([environmentId, projectId]) // "runs by env within a project"
  @@index([testDefinitionId, completedAt]) // "latest run for a test" (pass/fail history)
  @@index([triggeredById, createdAt]) // "my recent runs"
  // Org-analytics indexes — keep the donut + leaderboard groupBy fast as
  // data grows. Without these the analytics page does a sequential scan on
  // big projects.
  @@index([projectId, status, failureCategory])
  @@index([projectId, failureCategory, createdAt(sort: Desc)])
  @@map("test_runs")
}

model FeatureRun {
  id               String           @id @default(uuid())
  status           FeatureRunStatus @default(IDLE)
  runMode          RunMode          @default(AUTOMATED)
  // How the run started: manual | scheduled | api | ci | promotion.
  trigger          String           @default("manual")
  // Snapshot of Feature.concurrency at creation time (docs/plan/06-PHASE-4-SCALE.md
  // §4.1) — null on rows created before this migration, or edge cases;
  // callers fall back to DEFAULT_FEATURE_CONCURRENCY.
  concurrency      Int?
  // Snapshot of Feature.retryLadderEnabled at creation time (§4.2).
  retryLadderEnabled   Boolean      @default(true)
  // Snapshot of Feature.failFast at creation time (§4.5).
  failFast             Boolean      @default(false)
  // Which ladder wave this run is currently on (1 = first pass, 2 = batch-of-5
  // retry, 3 = serial retry — see RETRY_LADDER_MAX_ATTEMPT). Drives both the
  // top-up budget in onRunComplete() and the ladder's own stop condition.
  currentLadderAttempt Int          @default(1)
  startedAt        DateTime?
  completedAt      DateTime?
  duration         Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lastHeartbeatAt  DateTime?
  featureId        String
  feature          Feature          @relation(fields: [featureId], references: [id])
  environmentId    String?
  environment      Environment?     @relation(fields: [environmentId], references: [id])
  featureVersionId String?
  featureVersion   FeatureVersion?  @relation(fields: [featureVersionId], references: [id])
  triggeredById    String?
  triggeredBy      User?            @relation(fields: [triggeredById], references: [id])
  // Links this run to the phase context it was executed within (null = no phase active).
  featurePhaseId   String?
  featurePhase     FeaturePhase?    @relation("FeaturePhaseRuns", fields: [featurePhaseId], references: [id])
  testRuns         TestRun[]

  // Handover trail: when a feature run is promoted from one environment to
  // the next (e.g. QA → UAT), the new run carries this back-pointer to the
  // run it was promoted from. Lets reports answer "this UAT run originated
  // from QA pass on 2026-04-30, signed off by Alice".
  promotedFromId String?
  promotedFrom   FeatureRun?    @relation("FeatureRunPromotion", fields: [promotedFromId], references: [id])
  promotedTo     FeatureRun[]   @relation("FeatureRunPromotion")
  signoffs       PhaseSignoff[]

  // When this feature run is part of a named manual Test Run (umbrella spanning
  // multiple features), this points to it. Null for automated / standalone runs.
  testRunSessionId String?
  testRunSession   TestRunSession? @relation(fields: [testRunSessionId], references: [id], onDelete: SetNull)

  // The schedule that started this run (null = any other trigger). SetNull on
  // delete: the run happened, so it outlives the schedule — it just loses the
  // back-link. `trigger` alone can't identify WHICH schedule fired when a
  // feature+env has more than one.
  runScheduleId String?
  runSchedule   RunSchedule? @relation(fields: [runScheduleId], references: [id], onDelete: SetNull)

  // The pipeline run this FeatureRun executes a stage of (null = not a
  // pipeline stage). SetNull on delete for the same reason as runScheduleId:
  // the run evidence outlives the pipeline run record.
  pipelineRunId String?
  pipelineRun   PipelineRun? @relation(fields: [pipelineRunId], references: [id], onDelete: SetNull)

  // Hot-query indexes
  @@index([testRunSessionId])
  @@index([featureId, status]) // "runs for this feature, by status" — drives resume banner
  @@index([status, lastHeartbeatAt]) // "stuck runs with stale heartbeat" — feeds cleanup cron
  @@index([featureId, createdAt]) // "run history for a feature" — run history table
  @@index([promotedFromId]) // "what was promoted from this run"
  @@index([runScheduleId, createdAt]) // "run history for this schedule"
  @@index([pipelineRunId]) // "stage runs of this pipeline run"
  @@map("feature_runs")
}

// Recurring AUTOMATED feature runs: "run feature X on env Y at cron Z".
// Fired by RunSchedulesService's every-minute tick; nextRunAt is the claim
// token — the tick advances it atomically so concurrent API instances can't
// double-fire.
model RunSchedule {
  id               String      @id @default(uuid())
  projectId        String
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Target: exactly one of featureId / pipelineId (XOR, service-enforced).
  featureId        String?
  feature          Feature?    @relation(fields: [featureId], references: [id], onDelete: Cascade)
  pipelineId       String?
  pipeline         Pipeline?   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  // Environment applies to feature targets only — a pipeline carries an env
  // per stage, so pipeline schedules leave this null.
  environmentId    String?
  environment      Environment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  cronExpr         String      // 5-field cron, validated with cron-parser on save
  timezone         String      @default("UTC")
  enabled          Boolean     @default(true)
  lastRunAt        DateTime?
  nextRunAt        DateTime?   // recomputed on save + after each fire
  lastFeatureRunId String?     // most recent FeatureRun this schedule started
  featureRuns      FeatureRun[] // every run this schedule started — its history
  createdById      String
  createdBy        User        @relation(fields: [createdById], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([enabled, nextRunAt]) // the tick's due-scan
  @@index([projectId])
  @@map("run_schedules")
}

// ─── Pipelines: ordered multi-feature automated runs ────────────────────────
// A pipeline chains stages (feature + env + on-failure policy) SEQUENTIALLY as
// one CI-triggerable unit. A stage execution IS a FeatureRun (back-linked via
// FeatureRun.pipelineRunId); results are isolated from canonical feature
// stats by default (see Pipeline.updatesFeatureStatus).

enum StageFailurePolicy {
  HALT     // stage fails → remaining stages SKIPPED, run FAILED (fail-fast)
  CONTINUE // stage fails → keep going; run still FAILED overall at the end
}

enum PipelineRunStatus {
  RUNNING
  COMPLETE
  FAILED
  CANCELLED
}

model Pipeline {
  id          String          @id @default(uuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // When false (default), stage runs are excluded from feature latest-status,
  // stats, flaky detection, sign-off and the per-feature webhook — results
  // live per-pipeline only. When true, stage runs count like any automated run.
  updatesFeatureStatus Boolean @default(false)
  stages      PipelineStage[]
  runs        PipelineRun[]
  schedules   RunSchedule[]
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@map("pipelines")
}

model PipelineStage {
  id            String             @id @default(uuid())
  pipelineId    String
  pipeline      Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  order         Int                // 0-based, server-normalized contiguous
  featureId     String
  feature       Feature            @relation(fields: [featureId], references: [id], onDelete: Cascade)
  environmentId String
  environment   Environment        @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  onFailure     StageFailurePolicy @default(HALT)

  @@unique([pipelineId, order])
  @@map("pipeline_stages")
}

model PipelineRun {
  id                String            @id @default(uuid())
  pipelineId        String
  pipeline          Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  status            PipelineRunStatus @default(RUNNING)
  trigger           String            @default("manual") // manual|scheduled|api|ci
  // Definition snapshot at trigger time — editing the pipeline mid-run must
  // not affect an in-flight run.
  // [{order, featureId, environmentId, onFailure, featureName, envName}]
  stagesSnapshot    Json
  currentStageOrder Int               @default(0)
  // Per-stage outcomes as they land:
  // [{order, featureRunId?, status: 'PASSED'|'FAILED'|'SKIPPED'|'CANCELLED', passed, failed, errorMessage?}]
  stageResults      Json              @default("[]")
  startedAt         DateTime          @default(now())
  completedAt       DateTime?
  createdById       String?
  createdBy         User?             @relation(fields: [createdById], references: [id])
  featureRuns       FeatureRun[]

  @@index([pipelineId, startedAt]) // history, newest first
  @@index([status]) // safety-tick scan for RUNNING runs
  @@map("pipeline_runs")
}

enum RunSessionStatus {
  ACTIVE // in progress — tester is marking tests
  COMPLETED // tester finished the run
  ABANDONED // closed without finishing (manual abandon or stale-heartbeat cron)
}

/// A NAMED manual test run: a deliberate QA sitting that spans one or more
/// features. Sits ABOVE the per-feature machinery — it groups FeatureRuns +
/// their TestRuns + any Issues logged during the run, so a tester can name a
/// run, work across features, then view/report on it as one unit. Distinct from
/// QaWorkSession (an invisible presence tracker) and from FeatureRun (one
/// feature, automated execution + sign-off/promotion).
model TestRunSession {
  id              String           @id @default(uuid())
  name            String
  status          RunSessionStatus @default(ACTIVE)
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  duration        Int? // ms, stamped on finish/abandon
  lastHeartbeatAt DateTime?
  summary         String? // optional tester notes for the whole run
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  projectId            String
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Feature the run was started from — reports are stored against it.
  startedFromFeatureId String?
  startedFromFeature   Feature?     @relation("RunSessionStartFeature", fields: [startedFromFeatureId], references: [id])
  environmentId        String?
  environment          Environment? @relation(fields: [environmentId], references: [id])
  createdById          String?
  createdBy            User?        @relation(fields: [createdById], references: [id])

  testRuns    TestRun[]
  featureRuns FeatureRun[]
  issues      Issue[]
  reports     GeneratedReport[]

  @@index([projectId, status])
  @@index([createdById, startedAt])
  @@index([status, lastHeartbeatAt]) // stale-run cleanup cron
  @@map("test_run_sessions")
}

// Audit record for QA → UAT (or any cross-env) sign-off decisions. One row
// per (FeatureRun, decision-maker) pair. Keeps the test results immutable
// while still recording who approved a handover and any conditions/notes.
enum SignoffDecision {
  APPROVED
  REJECTED
}

model PhaseSignoff {
  id            String          @id @default(uuid())
  decision      SignoffDecision
  note          String?
  signedAt      DateTime        @default(now())
  featureRunId  String
  featureRun    FeatureRun      @relation(fields: [featureRunId], references: [id], onDelete: Cascade)
  environmentId String
  environment   Environment     @relation(fields: [environmentId], references: [id])
  signedById    String
  signedBy      User            @relation(fields: [signedById], references: [id])

  @@index([featureRunId, signedAt])
  @@map("phase_signoffs")
}

// ─── Sign-off system ────────────────────────────────────────────────────────
// Self-contained: its own config (SignoffApprover), state (FeatureEnvSignoff /
// ModuleEnvSignoff), signatures (SignoffApproval), and append-only audit trail
// (SignoffEvent). Built on Environment (a feature × environment matrix) — the
// older PhaseSignoff/FeatureSignOff/phase models are unused and left untouched.

enum SignoffStatus {
  AWAITING
  SIGNED
  REJECTED
}

enum SignoffEventType {
  REQUESTED
  APPROVED
  REJECTED
  MODULE_SIGNED
  CERT_GENERATED
  CONFIG_CHANGED
}

// Project config — who must sign. environmentId null = required for ALL envs.
model SignoffApprover {
  id            String       @id @default(uuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())

  @@unique([projectId, environmentId, userId])
  @@index([projectId])
  @@map("signoff_approvers")
}

// One cell = (feature × environment). Row created when the cell becomes eligible.
model FeatureEnvSignoff {
  id            String            @id @default(uuid())
  featureId     String
  feature       Feature           @relation(fields: [featureId], references: [id], onDelete: Cascade)
  environmentId String
  environment   Environment       @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  status        SignoffStatus     @default(AWAITING)
  eligibleAt    DateTime          @default(now())
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  approvals     SignoffApproval[]

  @@unique([featureId, environmentId])
  @@index([environmentId])
  @@map("feature_env_signoffs")
}

// One per approver decision (consensus → many per cell).
model SignoffApproval {
  id                  String            @id @default(uuid())
  featureEnvSignoffId String
  featureEnvSignoff   FeatureEnvSignoff @relation(fields: [featureEnvSignoffId], references: [id], onDelete: Cascade)
  signedById          String
  signedBy            User              @relation(fields: [signedById], references: [id])
  decision            SignoffDecision
  typedName           String
  drawnSignature      String? // data:image/png;base64
  note                String?
  signedAt            DateTime          @default(now())

  @@unique([featureEnvSignoffId, signedById])
  @@map("signoff_approvals")
}

// Explicit manager confirmation once all features in a module are signed in an env.
model ModuleEnvSignoff {
  id             String        @id @default(uuid())
  moduleId       String
  module         Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  environmentId  String
  environment    Environment   @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  status         SignoffStatus @default(SIGNED)
  signedById     String
  signedBy       User          @relation(fields: [signedById], references: [id])
  typedName      String
  drawnSignature String?
  note           String?
  signedAt       DateTime      @default(now())

  @@unique([moduleId, environmentId])
  @@map("module_env_signoffs")
}

// Append-only audit trail — source of truth for the history view + cert audit.
model SignoffEvent {
  id            String           @id @default(uuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          SignoffEventType
  featureId     String?
  moduleId      String?
  environmentId String?
  actorId       String?
  actor         User?            @relation(fields: [actorId], references: [id])
  detail        Json?
  createdAt     DateTime         @default(now())

  @@index([projectId, createdAt])
  @@map("signoff_events")
}

// ─── REPORT CONFIG (saved setup) ──────────────────────────────────────
// Reusable template — admin/manager picks once, regenerates whenever.
// "Weekly UAT Progress for Login feature" sticks here; the rendered file
// itself lives in GeneratedReport so history is preserved.
model ReportConfig {
  id             String            @id @default(uuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  type           ReportType
  // Scope: which entity this report covers. featureId / moduleId / phaseId
  // are mutually exclusive depending on `type`. PROJECT type uses none.
  featureId      String?
  moduleId       String?
  phaseId        String?
  environmentId  String? // optional env filter (null = all envs caller can see)
  // Section toggles — composability spec from TESTING_PHASES_AND_REPORTS.md
  includeSession Boolean           @default(false)
  includeFeature Boolean           @default(true)
  includeProject Boolean           @default(false)
  includeCharts  Boolean           @default(true)
  createdById    String
  createdBy      User              @relation(fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  reports        GeneratedReport[]

  @@index([projectId, createdAt])
  @@map("report_configs")
}

// ─── GENERATED REPORT (immutable snapshot) ────────────────────────────
// Every "generate" creates one of these. Captures the resolved data at
// the moment of generation plus an artifact path (HTML / PDF). Used for
// audit trail + historical trend tracking.
model GeneratedReport {
  id              String        @id @default(uuid())
  configId        String? // null when generated ad-hoc without saving config
  config          ReportConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Cascade-up scope keys (denormalised). All reports always set projectId.
  // featureId is set when the report is feature-scoped (also sets moduleId).
  // moduleId is set when scope is FEATURE or MODULE.
  // Letting feature reports surface in module + project Reports views without joins.
  moduleId        String?
  module          Module?       @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  featureId       String?
  feature         Feature?      @relation(fields: [featureId], references: [id], onDelete: SetNull)
  // Set for run-scoped reports so a named test run can surface + re-email its report.
  testRunSessionId String?
  testRunSession   TestRunSession? @relation(fields: [testRunSessionId], references: [id], onDelete: SetNull)
  type            ReportType
  format          ReportFormat
  title           String
  // Frozen snapshot of the resolved data + filters at generation time. Lets
  // the report be re-rendered or re-emailed without re-querying.
  payload         Json
  // Filesystem path under ARTIFACT_STORAGE_PATH/reports/ — null until the
  // generation job writes the file. Kept relative for portability.
  artifactPath    String?
  generatedById   String
  generatedBy     User          @relation(fields: [generatedById], references: [id])
  generatedAt     DateTime      @default(now())
  // Optional email delivery — if recipientEmails is non-empty, EmailService
  // is asked to send the rendered report (PDF as attachment, HTML inline)
  // immediately after generation. emailedAt is stamped on success; errors
  // are logged but never throw (report itself is still saved).
  recipientEmails String[]      @default([])
  emailedAt       DateTime?

  @@index([projectId, generatedAt])
  @@index([moduleId, generatedAt])
  @@index([featureId, generatedAt])
  @@index([testRunSessionId, generatedAt])
  @@map("generated_reports")
}

model RunStep {
  id            String         @id @default(uuid())
  index         Int
  name          String
  type          StepType
  status        StepStatus     @default(PENDING)
  input         Json?
  output        Json?
  errorMessage  String?
  notes         String?
  jiraIssueKey  String?
  screenshot    String?
  evidenceUrls  String[]       @default([])
  startedAt     DateTime?
  completedAt   DateTime?
  duration      Int?
  // Per-step retry outcome (docs/plan/04-PHASE-2-HEALING.md §2.3) — the
  // prerequisite for flake scoring in Phase 3: a step passing on attempt 2 is
  // a flake datapoint that was previously discarded by the retry loop.
  attempts       Int      @default(1)
  attemptsToPass Int?
  // This attempt's PASS used a selector fallback. Denormalized from
  // status === PASSED_HEALED so the give-up query (three consecutive heals on
  // the same step index) doesn't need to re-derive it from status.
  healed         Boolean  @default(false)
  // Phase 3 intelligence (docs/plan/05-PHASE-3-INTELLIGENCE.md). Both
  // computed once at write time by the worker (run.executor.ts), from the
  // same errorMessage this row already carries — no separate pass needed.
  //   §3.2 — normalised-and-hashed errorMessage; groups the same underlying
  //   defect across tests/runs/environments despite incidental differences
  //   (uuids, timestamps, ports). Null on a passing step.
  failureFingerprint String?
  //   §3.4 — first-pass heuristic bucket; null when nothing matched (never
  //   guessed). triageBucketOverridden freezes a human correction so a later
  //   run of the same failure can't silently overwrite it — the correction
  //   is itself the valuable signal (feeds Phase 6's manual-label corpus).
  triageBucket           TriageBucket?
  triageBucketOverridden Boolean       @default(false)
  createdAt     DateTime       @default(now())
  runId         String
  run           TestRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Denormalized from run.testDefinitionId so the give-up check (last N
  // executions of this exact step, across runs) needs no join — mirrors the
  // TestRun.pipelineRunId denormalization pattern used for the same reason.
  testDefinitionId String
  selectorHeals SelectorHeal[]

  // Honest reporting: which actor finished this step. Null until a step
  // reaches a terminal status. takeoverReason/takeoverAt are populated only
  // when the actor differs from the parent TestRun.runMode.
  executedBy     ExecutedBy?
  takeoverReason String?
  takeoverAt     DateTime?

  // Give-up query: "the last 2 executions of step N of test T" — kept warm
  // since selector drift detection reads this on every heal attempt.
  @@index([testDefinitionId, index, createdAt])
  // Failure clustering: "every occurrence of fingerprint X, oldest first" —
  // the run-detail grouping and the cross-run "first seen N days ago" query.
  @@index([failureFingerprint, createdAt])
  @@map("run_steps")
}

model SelectorHeal {
  id               String   @id @default(uuid())
  stepIndex        Int
  stepName         String
  originalSelector String?
  healedSelector   String
  confidence       String // "high" | "medium" | "low"
  source           String // "code" | "visual" | "code+visual"
  // Which authoring strategy the healed selector resolved to — see
  // apps/worker/src/steps/selector-heal.ts. Kept alongside the human-readable
  // `confidence` bucket for the promotion queue's before/after display.
  strategy         String?
  // Gated on run outcome (docs/plan/04-PHASE-2-HEALING.md §2.5): this row is
  // ALWAYS written the moment the heal fires — it is evidence of what
  // happened, even on a failing or preview run. What is gated is whether it
  // may ever be promoted into the stored step definition: only heals from a
  // run that ultimately passed and was not a preview become eligible, set by
  // a sweep after the owning run reaches a terminal status.
  eligibleForPromotion Boolean   @default(false)
  promoted             Boolean   @default(false)
  promotedAt           DateTime?
  promotedById         String?
  promotedBy           User?     @relation(fields: [promotedById], references: [id])
  createdAt        DateTime @default(now())
  runId            String
  run              TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId           String
  step             RunStep  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  testDefinitionId String
  testDefinition   TestDefinition @relation(fields: [testDefinitionId], references: [id])

  // Promotion/demotion review queue: pending heals for a project, newest first.
  @@index([testDefinitionId, eligibleForPromotion, promoted])
  @@map("selector_heals")
}

model Artifact {
  id        String       @id @default(uuid())
  type      ArtifactType
  filename  String
  path      String
  mimeType  String?
  sizeBytes Int?
  metadata  Json?
  createdAt DateTime     @default(now())
  runId     String
  run       TestRun      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("artifacts")
}

model AISummary {
  id        String        @id @default(uuid())
  type      AISummaryType
  model     String
  prompt    String
  response  String
  metadata  Json?
  createdAt DateTime      @default(now())
  // Optional now — generation calls (G1/G2/G3) have no run attached.
  runId     String?
  run       TestRun?      @relation(fields: [runId], references: [id], onDelete: Cascade)

  // BYOK + cost tracking. orgId scopes spend roll-ups; the rest record
  // per-call usage from provider response metadata (LangChain usage_metadata).
  orgId         String?
  org           Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inputTokens   Int?
  outputTokens  Int?
  costUsd       Decimal?      @db.Decimal(10, 6)
  durationMs    Int?
  // 'g1' | 'g2' | 'g3' | 'extract' | 'refine' | 'failure_explain' | 'run_summary'
  purpose       String?
  // e.g. "tests-from-feature@1.2" — recorded so old summaries stay reproducible
  promptVersion String?

  @@index([orgId, createdAt])
  @@map("ai_summaries")
}

// Per-org BYOK credential for AI generation. The API key (and any provider
// secret-shaped field) is encrypted via SecretsService — the row only
// holds the ciphertext blob plus the KEK keyId used at encryption time.
model OrgAiCredential {
  id    String       @id @default(uuid())
  orgId String       @unique
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  provider  AiProvider
  model     String // e.g. "gemini-2.0-flash"
  maxTokens Int        @default(4000)

  // AES-256-GCM envelope from SecretsService. Stores JSON { apiKey: string }.
  secretsCiphertext Bytes
  secretsKeyId      String

  // Provider-specific extras (all optional; populated based on provider)
  baseUrl         String? // Ollama / OpenAI-compatible
  azureInstance   String? // Azure only
  azureDeployment String? // Azure only
  azureApiVersion String? // Azure only

  // Quotas — enforced by AiQuotaGuard before each generation
  monthlyCapUsd           Decimal @default(50.00) @db.Decimal(10, 2)
  rateLimitPerUserPerHour Int     @default(20)

  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])

  @@map("org_ai_credentials")
}

// ── GitHub integration (Layer A — connections) ──────────────────────────────
// See ../QA_Planning_docs/docs/github-integration/01_CONNECTIONS_AND_REPOS.md

enum GitProvider {
  GITHUB
  GITHUB_ENTERPRISE
  GITLAB // future
}

enum GitAuthKind {
  APP
  PAT
}

enum RepoRole {
  FRONTEND
  BACKEND
  INFRA
  OTHER
}

enum RepoIndexStatus {
  PENDING
  INDEXING
  READY
  FAILED
}

/// Org-level GitHub auth, shared by every project in the org. One credential
/// per (org, provider, label). Secrets (PAT or App private key) live in the
/// AES-256-GCM envelope from SecretsService — never returned in API responses.
model OrgGitCredential {
  id           String       @id @default(uuid())
  orgId        String
  org          Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  provider     GitProvider @default(GITHUB)
  authKind     GitAuthKind
  displayLabel String?
  baseUrl      String? // GitHub Enterprise base URL, else null

  // App auth only
  appInstallationId String?

  // AES-256-GCM envelope. JSON { token } for PAT, or { privateKey, appId } for APP.
  secretsCiphertext Bytes
  secretsKeyId      String

  // Health
  lastHealthOk    Boolean   @default(false)
  lastHealthAt    DateTime?
  lastHealthError String?
  connectedAs     String? // login of the token/app, surfaced in the UI

  isEnabled   Boolean  @default(true)
  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  repos ProjectRepo[]

  @@unique([orgId, provider, displayLabel])
  @@index([orgId])
  @@map("org_git_credentials")
}

/// A repo linked to a project (N repos → 1 project). References the shared org
/// credential; a per-repo override token is only used when the repo lives in a
/// different GitHub org. Indexing fields drive Layer C (codebase context).
model ProjectRepo {
  id           String  @id @default(uuid())
  orgId        String
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credentialId String
  credential   OrgGitCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  role          RepoRole @default(OTHER)
  repoOwner     String
  repoName      String
  defaultBranch String   @default("main")

  // Per-repo override token (rare). JSON { token } when set.
  secretsCiphertext Bytes?
  secretsKeyId      String?

  // Indexing (Layer C — populated by the index job)
  includeGlobs  String[]        @default([])
  excludeGlobs  String[]        @default([])
  status        RepoIndexStatus @default(PENDING)
  chunkCount    Int             @default(0)
  lastIndexedAt DateTime?

  // Webhook (Layer B)
  webhookSecret     String?
  webhookExternalId String?

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, repoOwner, repoName])
  @@index([orgId, projectId])
  @@map("project_repos")
}

model AuditLog {
  id        String        @id @default(uuid())
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime      @default(now())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  orgId     String?
  org       Organisation? @relation(fields: [orgId], references: [id])
  // Request context (populated for token/MCP-driven actions; null for legacy rows).
  ip         String?
  userAgent  String?
  source     String? // 'web' | 'api-token' | 'mcp'
  apiTokenId String? // which UserApiToken made the call (when source != 'web')

  @@index([orgId, createdAt])
  @@index([apiTokenId])
  @@map("audit_logs")
}

// Audit record for every import operation — used for history and revert tracing
model ImportLog {
  id           String   @id @default(uuid())
  exportType   String // project | module | feature | testCase
  sourceName   String // name of the top-level imported item
  summary      Json // { modulesCreated, featuresCreated, testCasesCreated }
  conflicts    Json // array of { type, originalName, resolvedName }
  importedAt   DateTime @default(now())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  importedById String?
  importedBy   User?    @relation("ImportedBy", fields: [importedById], references: [id])

  @@map("import_logs")
}

// ─── 6-F: Access Requests ─────────────────────────────────────────────────────

model AccessRequest {
  id           String              @id @default(uuid())
  type         AccessRequestType
  status       AccessRequestStatus @default(PENDING)
  message      String? // requester's reason / context
  grantedRole  String? // OrgRole or ProjectRole set by admin on approval
  reviewerNote String? // optional note shown to requester on rejection
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  orgId        String
  org          Organisation        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId    String? // set for PROJECT type requests
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requesterId  String
  requester    User                @relation("RequestsMade", fields: [requesterId], references: [id])
  reviewedById String?
  reviewedBy   User?               @relation("RequestsReviewed", fields: [reviewedById], references: [id])

  @@map("access_requests")
}

/// A two-party handshake to move a Project from one Organisation to another.
///
/// Shaped after OrgInvite (token + expiresAt + status + one atomic apply on
/// accept) rather than AccessRequest, because a transfer needs BOTH sides to
/// consent: an ORG_ADMIN of `fromOrg` initiates by entering the destination
/// org's `transferCode`, and an ORG_ADMIN of `toOrg` accepts.
model ProjectTransferRequest {
  id     String                 @id @default(uuid())
  status ProjectTransferStatus  @default(PENDING)
  /// Opaque handle for the receiving admin's preview/accept URL.
  token     String   @unique @default(uuid())
  expiresAt DateTime

  message      String? // note from the sending admin
  decisionNote String? // note from the receiving admin on accept/reject

  /// Snapshot of the pre-flight plan shown to both sides at request time
  /// (slug conflict + rename, members to purge, bindings to sever). It is
  /// re-computed and re-validated inside the accept transaction — this copy is
  /// for display + audit, never the source of truth.
  plan Json?

  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromOrgId String
  fromOrg   Organisation @relation("TransfersFromOrg", fields: [fromOrgId], references: [id], onDelete: Cascade)
  toOrgId   String
  toOrg     Organisation @relation("TransfersToOrg", fields: [toOrgId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User    @relation("TransfersRequested", fields: [requestedById], references: [id])
  reviewedById  String?
  reviewedBy    User?   @relation("TransfersReviewed", fields: [reviewedById], references: [id])

  @@index([toOrgId, status])
  @@index([fromOrgId, status])
  @@index([projectId, status])
  @@map("project_transfer_requests")
}

/// Distinct from InviteStatus: a transfer can be REJECTED by the receiving
/// admin (a decision) as well as CANCELLED by the sender (a withdrawal), and
/// those must be tellable apart in the audit trail + emails.
enum ProjectTransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

// ─── 6-G: SSO Accounts ────────────────────────────────────────────────────────

model UserSsoAccount {
  id         String      @id @default(uuid())
  provider   SsoProvider
  providerId String // provider's unique user ID
  email      String // email from the provider
  linkedAt   DateTime    @default(now())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("user_sso_accounts")
}

// Refresh tokens. One row per active session (browser tab/device). Access
// tokens are short-lived (15 min) and stateless; long-lived auth comes from
// these rows. Stored as a sha256 hash so a leaked DB row can't be replayed.
// Revocation = set `revokedAt`. Cleaned up by the stuck-runs-style cron when
// expired or revoked > 30 days.
model UserRefreshToken {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the actual token value. Indexed unique for O(1) lookup on
  // refresh. The plaintext is only sent to the client once on issuance.
  tokenHash     String            @unique
  // Free-form metadata for the sessions UI ("Revoke this device"). Captured
  // from the request that issued the token; not used for auth decisions.
  userAgent     String?
  ipAddress     String?
  // Lifecycle.
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String? // 'logout' | 'rotated' | 'admin' | 'password-change' | 'token-expired'
  // The refresh-token rotation pattern: when a refresh succeeds, the old
  // row is marked revokedAt + we link to the freshly-issued replacement so
  // we can detect token replay (an attempt to use a revoked-but-rotated
  // token = lateral attacker).
  replacedById  String?           @unique
  replacedBy    UserRefreshToken? @relation("Rotation", fields: [replacedById], references: [id], onDelete: SetNull)
  predecessor   UserRefreshToken? @relation("Rotation")

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_refresh_tokens")
}

/// Personal access token (PAT) — a long-lived, user-scoped credential used by
/// the MCP server and direct API access. Like UserRefreshToken, only the
/// SHA-256 hash is stored; the plaintext `qapt_…` is shown once on issue. The
/// token carries the owner's full RBAC, enforced live on every call.
model UserApiToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String // user-given label, e.g. "Cursor on my laptop"
  tokenHash  String   @unique // SHA-256 of the plaintext; O(1) lookup on auth
  prefix     String // non-secret display hint, e.g. "qapt_ab12cd"
  scopes     String[] @default(["*"]) // reserved for future per-token scoping
  // Lifecycle
  expiresAt   DateTime? // null = never expires
  lastUsedAt  DateTime?
  lastUsedIp  String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_api_tokens")
}

// ─── TESTING PHASES ──────────────────────────────────────────────────────────

enum PhaseRole {
  TESTER
  MANAGER
  VIEWER
}

enum PhaseStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  BLOCKED
  SKIPPED
}

enum ReportType {
  FEATURE // single feature + its phases
  MODULE // all features in a module, per phase
  PROJECT // all modules, all phases
  PHASE // all features in a specific phase
  SESSION // a single QA work session — what happened during this sitting
}

enum ReportFormat {
  HTML
  PDF
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReportScope {
  FEATURE
  MODULE
  PROJECT
}

// Project phases — configured in Project Settings by ORG_ADMIN or project OWNER/TECH_LEAD.
model ProjectPhase {
  id          String  @id @default(uuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int
  color       String?
  autoPromote Boolean @default(false)

  // Environment assigned to this phase. Testers use this env when testing in this phase.
  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id])

  // Emails that always receive the handover report when a feature is promoted INTO this phase.
  handoverRecipients String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments     PhaseAssignment[]
  featurePhases   FeaturePhase[]
  reportSchedules PhaseReportSchedule[]

  @@unique([projectId, order])
  @@map("project_phases")
}

model PhaseAssignment {
  id      String       @id @default(uuid())
  phaseId String
  phase   ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  userId  String
  user    User         @relation(fields: [userId], references: [id])
  role    PhaseRole

  @@unique([phaseId, userId])
  @@map("phase_assignments")
}

// Tracks where each feature sits in the phase pipeline.
model FeaturePhase {
  id           String       @id @default(uuid())
  featureId    String
  feature      Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade)
  phaseId      String
  phase        ProjectPhase @relation(fields: [phaseId], references: [id])
  status       PhaseStatus  @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime? // set when status → PASSED or FAILED
  promotedAt   DateTime? // set when promoted to the next phase
  promotedById String?
  promotedBy   User?        @relation("FeaturePhasePromotions", fields: [promotedById], references: [id])
  notes        String? // promotion note, block reason, etc.

  // Handover email tracking (populated at promotion time).
  handoverSentTo String[]  @default([])
  handoverSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  featureRuns FeatureRun[] @relation("FeaturePhaseRuns")

  @@unique([featureId, phaseId])
  @@map("feature_phases")
}

// Terminal approval record — created when a feature passes all phases and is signed off.
model FeatureSignOff {
  id             String   @id @default(uuid())
  featureId      String   @unique
  feature        Feature  @relation(fields: [featureId], references: [id])
  signedOffById  String
  signedOffBy    User     @relation("FeatureSignOffs", fields: [signedOffById], references: [id])
  signedOffAt    DateTime @default(now())
  message        String?
  notifiedEmails String[] @default([])

  @@map("feature_sign_offs")
}

model PhaseReportSchedule {
  id            String          @id @default(uuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId       String?
  phase         ProjectPhase?   @relation(fields: [phaseId], references: [id])
  scope         ReportScope
  scopeId       String? // featureId or moduleId when scope != PROJECT
  name          String
  frequency     ReportFrequency
  dayOfWeek     Int? // 0–6 for WEEKLY
  dayOfMonth    Int? // 1–28 for MONTHLY
  sendTime      String // "09:00" HH:mm in org timezone
  recipients    String[]
  includeCharts Boolean         @default(true)
  // Optional saved filter spec (tags/epics/status/search/date range). When
  // set, the scheduled report is generated over the matching subset and the
  // filters are echoed in the report header. Null = whole-scope report.
  appliedFilters Json?
  lastSentAt    DateTime?
  createdById   String
  createdBy     User            @relation(fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("phase_report_schedules")
}

// ─── PLUGIN REGISTRY (§5.3 / replaces §5.8) ──────────────────────────────────

enum MappingDirection {
  OUTBOUND
  INBOUND
  BIDIRECTIONAL
}

enum MappingTargetType {
  PHASE
  ISSUE_STATUS
}

enum InboundSource {
  MANUAL_REFRESH
  WEBHOOK
  BULK_SYNC
}

enum SuggestionKind {
  AUTO_APPLIED
  PENDING_APPROVAL
  UNMAPPED
}

// Installed plugins at the org level — stores encrypted secrets and non-secret config.
model OrgPluginInstall {
  id            String @id @default(uuid())
  orgId         String
  pluginId      String // "clickup", "jira", ...
  pluginVersion String // frozen at install; used for migration triggers

  displayLabel String? // optional — "Acme ClickUp (primary)" when same plugin installed twice
  isEnabled    Boolean @default(true)

  // Non-secret config (JSON validated against plugin.configSchema at write-time)
  config Json

  // Secrets — encrypted via AES-256-GCM with key from SECRETS_KEK env var
  secretsCiphertext Bytes
  secretsKeyId      String // key rotation identifier

  // Health
  lastHealthOk    Boolean   @default(false)
  lastHealthAt    DateTime?
  lastHealthError String?

  installedById String
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org         Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  installedBy User         @relation("PluginInstallCreator", fields: [installedById], references: [id])

  projectBindings  ProjectPluginBinding[]
  moduleBindings   ModulePluginBinding[]
  featureBindings  FeaturePluginBinding[]
  ticketLinks      TicketLink[]
  docLinks         DocLink[]
  acSourceLinks    TestAcSourceLink[]
  webhookEndpoints PluginWebhookEndpoint[]
  webhookEvents    WebhookEvent[]
  clickupUserLinks ClickUpUserLink[]
  clickupTokens    UserClickUpToken[]

  @@unique([orgId, pluginId, displayLabel])
  @@index([orgId, pluginId])
  @@map("org_plugin_installs")
}

/// Maps a QA-platform user to their external (ClickUp) user for a given
/// install/workspace, so assigning an issue here can also assign the linked
/// ClickUp task. External user ids are integers and workspace-specific, hence
/// the install scope. Generic enough to extend to other trackers later.
model ClickUpUserLink {
  id              String   @id @default(uuid())
  orgId           String
  installId       String
  qaUserId        String
  clickupUserId   Int
  clickupUsername String?
  clickupEmail    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org     Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  install OrgPluginInstall @relation(fields: [installId], references: [id], onDelete: Cascade)
  qaUser  User             @relation("UserClickUpLinks", fields: [qaUserId], references: [id], onDelete: Cascade)

  @@unique([installId, qaUserId])
  @@unique([installId, clickupUserId])
  @@index([orgId])
  @@map("clickup_user_links")
}

/// A user's OWN ClickUp personal token, so their ClickUp actions (create bug,
/// status change, comment) are attributed to THEM instead of the shared org
/// integration token. Opt-in: with no token, actions fall back to the org
/// token. Scoped per install (CU tokens are workspace-specific). The token is
/// encrypted at rest (AES-256-GCM via SecretsService) — never hashed (we replay
/// it to ClickUp) and never returned to the client.
model UserClickUpToken {
  id        String @id @default(uuid())
  userId    String
  installId String

  // AES-256-GCM envelope. JSON { token }.
  secretsCiphertext Bytes
  secretsKeyId      String

  // ClickUp identity (from getUser) — drives auto-link + attribution display.
  clickupUserId   Int?
  clickupUsername String?
  clickupEmail    String?
  connectedAs     String? // "username (email)" surfaced in the UI

  // Health (validated against ClickUp on save).
  lastHealthOk    Boolean   @default(false)
  lastHealthAt    DateTime?
  lastHealthError String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?

  user    User             @relation("UserClickUpTokens", fields: [userId], references: [id], onDelete: Cascade)
  install OrgPluginInstall @relation(fields: [installId], references: [id], onDelete: Cascade)

  @@unique([userId, installId])
  @@index([installId])
  @@map("user_clickup_tokens")
}

// Project-level binding + config override
model ProjectPluginBinding {
  id        String @id @default(uuid())
  orgId     String
  projectId String
  installId String

  bindingConfig          Json
  enabledCapabilities    String[] @default([])
  autoApplyInboundStatus Boolean  @default(false)
  notifyUnmappedStatus   Boolean  @default(true)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  install        OrgPluginInstall      @relation(fields: [installId], references: [id], onDelete: Cascade)
  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statusMappings PluginStatusMapping[]

  @@unique([projectId, installId])
  @@index([orgId, projectId])
  @@map("project_plugin_bindings")
}

// Module-level override (cascading config — partial shape)
model ModulePluginBinding {
  id        String @id @default(uuid())
  moduleId  String
  installId String

  bindingConfig Json

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  install OrgPluginInstall @relation(fields: [installId], references: [id], onDelete: Cascade)
  module  Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, installId])
  @@map("module_plugin_bindings")
}

// Feature-level override (cascading config — partial shape)
model FeaturePluginBinding {
  id        String @id @default(uuid())
  featureId String
  installId String

  bindingConfig Json

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  install OrgPluginInstall @relation(fields: [installId], references: [id], onDelete: Cascade)
  feature Feature          @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([featureId, installId])
  @@map("feature_plugin_bindings")
}

// Status mapping — bi-directional between platform values and external statuses.
model PluginStatusMapping {
  id         String            @id @default(uuid())
  bindingId  String
  direction  MappingDirection
  targetType MappingTargetType

  platformValue String // phase name OR issue status string
  externalValue String // e.g. "Ready for UAT", "Resolved"

  binding ProjectPluginBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([bindingId, direction, targetType, platformValue, externalValue])
  @@index([bindingId, direction])
  @@map("plugin_status_mappings")
}

// External ticket link — generalised (replaces FeatureTicketLink).
model TicketLink {
  id        String @id @default(uuid())
  orgId     String
  installId String

  // Scope — exactly one of these is set (one of feature/module/project/issue/finding)
  featureId String?
  moduleId  String?
  projectId String?
  findingId String? // SessionFinding (exploratory) — relation added when model lands
  issueId   String? // manual testing Issue / Snag

  externalId    String
  externalUrl   String
  externalTitle String?

  // External status snapshot
  externalStatus        String?
  externalStatusColor   String?
  externalStatusType    String? // "open" | "custom" | "closed"
  externalAssignees     Json?
  externalLastUpdatedAt DateTime?

  // Epic snapshot — cached from the external task's custom fields so the
  // module table can render epic chips without an API call per feature row.
  externalEpicName  String?
  externalEpicColor String?

  // Outbound sync state
  lastOutboundSyncAt    DateTime?
  lastOutboundSyncError String?

  // Inbound sync state
  lastInboundSyncAt    DateTime?
  lastInboundSyncError String?
  lastInboundSource    InboundSource?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  install OrgPluginInstall @relation(fields: [installId], references: [id], onDelete: Cascade)
  org     Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  feature Feature?         @relation(fields: [featureId], references: [id])
  module  Module?          @relation(fields: [moduleId], references: [id])
  project Project?         @relation(fields: [projectId], references: [id])
  issue   Issue?           @relation(fields: [issueId], references: [id])

  suggestions TicketStatusSuggestion[]

  @@unique([installId, externalId, featureId])
  @@index([orgId, featureId])
  @@index([orgId, issueId])
  @@map("ticket_links")
}

// Pending inbound status suggestion — recorded when external status changes
// and either no mapping exists or autoApplyInboundStatus=false.
model TicketStatusSuggestion {
  id           String @id @default(uuid())
  ticketLinkId String

  externalStatus String
  mappedStatus   String? // null = no mapping found
  suggestionKind SuggestionKind // AUTO_APPLIED | PENDING_APPROVAL | UNMAPPED

  appliedById   String?
  appliedAt     DateTime?
  dismissedById String?
  dismissedAt   DateTime?

  createdAt DateTime @default(now())

  ticketLink  TicketLink @relation(fields: [ticketLinkId], references: [id], onDelete: Cascade)
  appliedBy   User?      @relation("TicketSuggestionApplier", fields: [appliedById], references: [id])
  dismissedBy User?      @relation("TicketSuggestionDismisser", fields: [dismissedById], references: [id])

  @@index([ticketLinkId, appliedAt])
  @@map("ticket_status_suggestions")
}

// External doc link — many-to-many across project/module/feature scopes.
model DocLink {
  id        String @id @default(uuid())
  orgId     String
  installId String

  projectId        String?
  moduleId         String?
  featureId        String?
  testDefinitionId String?

  externalId  String // ClickUp Doc id, Confluence page id, ...
  externalUrl String
  title       String
  summary     String?

  // When set, the link targets a specific page within the doc (rather than the
  // whole doc). NULL = whole-doc link; render every page on fetch.
  pageId String?

  // External content type, used by the viewer to pick a render path:
  //   - a Google-native type (…google-apps.document/…spreadsheet/…presentation)
  //     → exported to HTML, rendered inline from cachedMarkdown
  //   - application/pdf, image/* → streamed live via /doc-links/:id/raw → iframe
  //   - …google-apps.folder → a linked folder, browsed via /folder-children
  // NULL for legacy ClickUp links (treated as markdown).
  externalMimeType String?

  // True when this link points at a folder rather than a single doc. Folder
  // links are project-scoped and expand to a browsable file list.
  isFolder Boolean @default(false)

  // Cache (24h TTL by default). When pageId is set, the cache stores just
  // that page's markdown; otherwise the whole stitched document.
  cachedMarkdown String?
  cachedAt       DateTime?
  cacheExpiresAt DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  install        OrgPluginInstall @relation(fields: [installId], references: [id], onDelete: Cascade)
  org            Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project        Project?         @relation(fields: [projectId], references: [id])
  module         Module?          @relation(fields: [moduleId], references: [id])
  feature        Feature?         @relation(fields: [featureId], references: [id])
  testDefinition TestDefinition?  @relation(fields: [testDefinitionId], references: [id])

  @@index([orgId, featureId])
  @@index([orgId, moduleId])
  @@index([orgId, projectId])
  @@index([orgId, testDefinitionId])
  @@map("doc_links")
}

/// Manual ("local") docs authored inside the QA platform.
///
/// Same multi-scope shape as DocLink (project/module/feature/test) so the
/// surface chrome can render both kinds in one list. Storage is plain
/// markdown; rendering happens on the frontend with a markdown library.
///
/// Where DocLink mirrors an external system, Doc is fully owned here —
/// editable, versioned by updatedAt, soft-deletable.
model Doc {
  id    String @id @default(uuid())
  orgId String

  projectId        String?
  moduleId         String?
  featureId        String?
  testDefinitionId String?

  title    String
  markdown String  @default("")
  /// Optional one-line summary used in list views; falls back to first line of markdown.
  summary  String?

  authorId String?
  editorId String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  org            Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project        Project?        @relation(fields: [projectId], references: [id])
  module         Module?         @relation(fields: [moduleId], references: [id])
  feature        Feature?        @relation(fields: [featureId], references: [id])
  testDefinition TestDefinition? @relation(fields: [testDefinitionId], references: [id])
  author         User?           @relation("DocAuthor", fields: [authorId], references: [id])
  editor         User?           @relation("DocEditor", fields: [editorId], references: [id])

  @@index([orgId, featureId])
  @@index([orgId, moduleId])
  @@index([orgId, projectId])
  @@index([orgId, testDefinitionId])
  @@map("docs")
}

// Plugin-managed inbound webhook endpoint.
model PluginWebhookEndpoint {
  id            String    @id @default(uuid())
  installId     String
  path          String    @unique // /webhooks/plugins/{orgId}/{installId}/{token}
  signingSecret String // platform-side HMAC secret
  externalId    String? // upstream system's webhook id (for de-registration)
  isActive      Boolean   @default(true)
  lastCalledAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  install OrgPluginInstall @relation(fields: [installId], references: [id], onDelete: Cascade)

  @@map("plugin_webhook_endpoints")
}

// Audit row per inbound webhook delivery (30-day retention).
model WebhookEvent {
  id        String @id @default(uuid())
  orgId     String
  installId String

  eventType      String? // upstream-declared event name (best effort)
  signatureValid Boolean
  payloadDigest  String // SHA-256 hex of raw body
  payload        Json? // full body only when WEBHOOK_PAYLOAD_RETENTION=full
  responseStatus Int? // HTTP status returned to caller
  errorMessage   String?

  receivedAt DateTime @default(now())

  org     Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  install OrgPluginInstall @relation(fields: [installId], references: [id], onDelete: Cascade)

  @@index([orgId, receivedAt])
  @@index([installId, receivedAt])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationCategory {
  RUN
  PHASE
  ASSIGNMENT
  AI
  TEAM
  REPORT
  SYSTEM
}

enum NotificationType {
  FEATURE_RUN_PASSED
  FEATURE_RUN_FAILED
  FEATURE_RUN_PARTIAL
  TEST_CASE_FAILED
  FEATURE_PROMOTED
  PHASE_REQUIRES_SIGN_OFF
  FEATURE_SIGNED_OFF
  PHASE_FAILED
  ASSIGNED_TO_PHASE
  ADDED_TO_PROJECT
  ROLE_CHANGED
  SELECTOR_HEALS_DETECTED
  DUPLICATE_TESTS_DETECTED
  TEST_SUGGESTIONS_READY
  FLAKY_TEST_FLAGGED
  INVITE_ACCEPTED
  ACCESS_REQUEST_SUBMITTED
  ACCESS_REQUEST_APPROVED
  ACCESS_REQUEST_REJECTED
  SCHEDULED_REPORT_READY
  SESSION_REPORT_SENT
  ENVIRONMENT_UNREACHABLE
  INTEGRATION_FAILED
  CREDIT_LOW
  ISSUE_MENTIONED
  ISSUE_ASSIGNED
  ISSUE_STATUS_CHANGED
  TEST_FAILURE_MENTIONED
  FEATURE_SIGNOFF_REQUESTED
  MODULE_SIGNED_OFF
  PROJECT_TRANSFER_REQUESTED
  PROJECT_TRANSFER_ACCEPTED
  PROJECT_TRANSFER_REJECTED
  PROJECT_TRANSFER_CANCELLED
}

model Notification {
  id     String @id @default(uuid())
  orgId  String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type                 NotificationType
  category             NotificationCategory
  title                String
  body                 String
  isRead               Boolean              @default(false)
  readAt               DateTime?
  actionUrl            String?
  actionLabel          String?
  secondaryActionUrl   String?
  secondaryActionLabel String?
  meta                 Json                 @default("{}")
  expiresAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead, createdAt])
  @@index([orgId, createdAt])
  @@map("notifications")
}

// ─── ISSUE / BUG / SNAG / QUERY TRACKING ─────────────────────────────────────

// An issue (bug, snag, or query) logged by QA against a test, feature, module, or project.
// Issues persist permanently — never purged — and track the full dev/QA resolution cycle.
model Issue {
  id                String        @id @default(uuid())
  type              IssueType
  // Root-cause classification — re-uses the TestFailureCategory enum so
  // bug-cause analytics and test-failure-cause analytics live on the same
  // axis. Optional at the column level so existing rows stay valid; the
  // service stamps FUNCTIONALITY on create when not provided.
  category          TestFailureCategory?
  status            IssueStatus   @default(OPEN)
  severity          IssueSeverity @default(MEDIUM)
  title             String
  description       String?
  stepsToReproduce  String?
  expectedBehaviour String?
  actualBehaviour   String?
  screenshotUrls    String[]      @default([])
  recordingUrl      String?       // back-compat: first recording (mirror of recordingUrls[0])
  recordingUrls     String[]      @default([])

  // Hierarchy — all optional so an issue can be scoped at any level
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId         String?
  module           Module?         @relation(fields: [moduleId], references: [id])
  featureId        String?
  feature          Feature?        @relation(fields: [featureId], references: [id])
  testDefinitionId String?
  testDefinition   TestDefinition? @relation(fields: [testDefinitionId], references: [id])
  testRunId        String?
  runStepId        String? // specific step where it was caught (for deep link)

  // People
  reportedById String
  reportedBy   User      @relation("IssueReporter", fields: [reportedById], references: [id])
  assignedToId String?
  assignedTo   User?     @relation("IssueAssignee", fields: [assignedToId], references: [id])
  resolvedById String?
  resolvedBy   User?     @relation("IssueResolver", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?

  // External push goes through plugin TicketLink (5.3 plugin registry)
  ticketLinks TicketLink[]

  // Audit
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  statusHistory IssueStatusHistory[]
  comments      IssueComment[]
  views         IssueView[]

  workSessionId String?
  workSession   QaWorkSession? @relation(fields: [workSessionId], references: [id], onDelete: SetNull)
  // Bug logged during a named manual Test Run (null otherwise).
  testRunSessionId String?
  testRunSession   TestRunSession? @relation(fields: [testRunSessionId], references: [id], onDelete: SetNull)

  @@index([testRunSessionId])
  @@index([projectId, status, type])
  @@index([featureId, status])
  @@index([testDefinitionId, status])
  @@index([workSessionId])
  @@index([assignedToId, status]) // "my open issues"
  @@index([testRunId]) // deep-link from run step → issues
  @@index([projectId, createdAt]) // "recent issues in project"
  @@index([projectId, category, status]) // category breakdown for org analytics
  @@map("issues")
}

// Immutable audit trail — one row per status transition.
model IssueStatusHistory {
  id          String       @id @default(uuid())
  issueId     String
  issue       Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  fromStatus  IssueStatus?
  toStatus    IssueStatus
  note        String?
  changedById String
  changedBy   User         @relation(fields: [changedById], references: [id])
  createdAt   DateTime     @default(now())

  @@map("issue_status_history")
}

// Comments thread on an issue — dev feedback, QA notes, back-and-forth.
model IssueComment {
  id        String    @id @default(uuid())
  issueId   String
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  content   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("issue_comments")
}

// View tracking — who has seen each issue and when
model IssueView {
  id            String   @id @default(uuid())
  issueId       String
  issue         Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstViewedAt DateTime @default(now())
  lastViewedAt  DateTime @default(now())
  viewCount     Int      @default(1)

  @@unique([issueId, userId])
  @@index([issueId, lastViewedAt])
  @@map("issue_views")
}

// ─── QA WORK SESSIONS ────────────────────────────────────────────────────────

model QaWorkSession {
  id           String    @id @default(uuid())
  userId       String
  orgId        String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  lastActiveAt DateTime  @default(now())
  endedReason  String? // 'manual' | 'logout' | 'idle-timeout' | 'org-switch' | 'token-expired'

  // Track the last test the user worked on — for the "continue where you left off" card
  lastTestDefinitionId String?
  lastFeatureId        String?
  lastModuleId         String?
  lastProjectId        String?
  lastActivityAt       DateTime?
  lastActivityType     String? // 'MARK_PASS' | 'MARK_FAIL' | 'TEST_MODE' | 'ISSUE_LOGGED'

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org      Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  testRuns TestRun[]
  issues   Issue[]

  @@index([userId, orgId, endedAt])
  @@index([orgId, startedAt])
  @@map("qa_work_sessions")
}

model Upload {
  id           String    @id @default(uuid())
  filename     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  token        String    @unique
  expiresAt    DateTime?
  orgId        String
  uploadedById String
  uploadedBy   User      @relation("UserUploads", fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())

  @@map("uploads")
}

// ─── PERSONAL NOTES ──────────────────────────────────────────────────────────

model UserProjectNote {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  content   String   @default("")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("user_project_notes")
}

/// One shared markdown note per test (the "Test notes" tab) — visible to anyone
/// with access to the test's project. lastEditedBy tracks the most recent
/// author. Personal notes reuse the per-project UserProjectNote.
model TestNote {
  id               String         @id @default(uuid())
  testDefinitionId String         @unique
  content          String         @default("")
  lastEditedById   String?
  test             TestDefinition @relation(fields: [testDefinitionId], references: [id], onDelete: Cascade)
  lastEditedBy     User?          @relation("TestNoteEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("test_notes")
}

// ─── TEST AC SOURCE LINK ─────────────────────────────────────────────────────
// Links a TestDefinition.description to a section of a ClickUp doc page.
// Sync fetches the latest content; Apply writes it to test.description and
// snapshots the previous value for one-step undo.

model TestAcSourceLink {
  id              String  @id @default(uuid())
  testId          String  @unique
  installId       String
  docId           String // external doc id (ClickUp)
  pageId          String // external doc page id
  sectionSlug     String? // heading slug; null = whole page
  pageTitle       String?
  sectionTitle    String?
  // Item-level anchoring within a section (optional). Fingerprint is a hash of
  // the item's first-line text — survives reordering, breaks on rename.
  itemFingerprint String?
  itemTitle       String?
  externalUrl     String // deep link to the page/section

  // Sync state — last fetch from the source
  lastSyncedAt      DateTime?
  lastSyncedContent String? // most recent slice fetched (not yet applied to description)
  lastSyncedHash    String? // hash of lastSyncedContent for change detection

  // Apply state — what's currently reflected in test.description
  lastAppliedAt   DateTime?
  lastAppliedHash String? // hash of content currently in test.description from this source

  // Undo window — previous description before the last Apply
  previousDescription String?
  previousAppliedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  test    TestDefinition   @relation(fields: [testId], references: [id], onDelete: Cascade)
  install OrgPluginInstall @relation(fields: [installId], references: [id], onDelete: Cascade)

  @@index([installId])
  @@map("test_ac_source_links")
}
